{
  "format": "bintana-form/1",
  "class": "RatesForm",
  "properties": {
    "Text": "Rates",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 700,
    "Height": 520,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblRatesTitle",
      "properties": {
        "Ellipsize": true,
        "HAlign": "Fill",
        "HExpand": true,
        "Height": 20,
        "Style": "heading",
        "Text": "Rates",
        "Width": 668
      }
    },
    {
      "type": "TableView",
      "name": "RatesList",
      "properties": {
        "Columns": [
          {
            "Text": "From",
            "Width": 140
          },
          {
            "Text": "To",
            "Width": 140
          },
          {
            "Text": "Table",
            "Width": 50
          },
          {
            "Text": "Rate",
            "Width": 80,
            "Alignment": "Right"
          },
          {
            "Text": "Overtime rate",
            "Width": 100,
            "Alignment": "Right"
          },
          {
            "Text": "Cost per use",
            "Width": 100,
            "Alignment": "Right"
          }
        ],
        "HAlign": "Fill",
        "Height": 160,
        "Style": "frame",
        "Width": 666
      }
    },
    {
      "type": "Grid",
      "name": "RateFields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 234,
        "RowSpacing": 6,
        "Spacing": 8,
        "Width": 668
      },
      "children": [
        {
          "type": "Label",
          "name": "LblRateFrom",
          "properties": {
            "HAlign": "End",
            "Text": "From"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtRateFrom",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        },
        {
          "type": "Label",
          "name": "LblRateTo",
          "properties": {
            "HAlign": "End",
            "Text": "To"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtRateTo",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        },
        {
          "type": "Label",
          "name": "LblRateTable",
          "properties": {
            "HAlign": "End",
            "Text": "Table"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbRateTable",
          "properties": {
            "HAlign": "Fill",
            "Index": 0,
            "Items": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "Text": "A"
          }
        },
        {
          "type": "Label",
          "name": "LblRateStandard",
          "properties": {
            "HAlign": "End",
            "Text": "Rate"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtRateStandard",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "0"
          }
        },
        {
          "type": "Label",
          "name": "LblRateOvertime",
          "properties": {
            "HAlign": "End",
            "Text": "Overtime rate"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtRateOvertime",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "0"
          }
        },
        {
          "type": "Label",
          "name": "LblRateCostUse",
          "properties": {
            "HAlign": "End",
            "Text": "Cost per use"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtRateCostUse",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "0"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "RateButtons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 6,
        "Width": 668
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnRateAdd",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "list-add-symbolic",
            "Text": "Add"
          }
        },
        {
          "type": "Button",
          "name": "BtnRateDel",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "list-remove-symbolic",
            "Text": "Remove"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 668
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

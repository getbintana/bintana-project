{
  "format": "bintana-form/1",
  "class": "ResourcesForm",
  "properties": {
    "Text": "Resources",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 620,
    "Height": 456,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblList",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Resources",
        "Width": 77
      }
    },
    {
      "type": "TableView",
      "name": "Resources",
      "properties": {
        "Columns": [
          {
            "Text": "Name",
            "Width": 0
          },
          {
            "Text": "Max",
            "Width": 50,
            "Alignment": "Right"
          },
          {
            "Text": "Peak",
            "Width": 50,
            "Alignment": "Right"
          },
          {
            "Text": "Rate",
            "Width": 60,
            "Alignment": "Right"
          },
          {
            "Text": "Cost",
            "Width": 70,
            "Alignment": "Right"
          }
        ],
        "HAlign": "Fill",
        "Height": 170,
        "Style": "frame",
        "Width": 586
      }
    },
    {
      "type": "Label",
      "name": "LblResEmpty",
      "properties": {
        "HAlign": "Start",
        "Height": 12,
        "Style": "dim-label",
        "Text": "No resources in this file",
        "Visible": false,
        "Width": 12
      }
    },
    {
      "type": "Grid",
      "name": "ResFields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 224,
        "RowSpacing": 4,
        "Spacing": 8,
        "Width": 588
      },
      "children": [
        {
          "type": "Label",
          "name": "LblResName",
          "properties": {
            "HAlign": "End",
            "Text": "Name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtResName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "Ana"
          }
        },
        {
          "type": "Label",
          "name": "LblResType",
          "properties": {
            "HAlign": "End",
            "Text": "Type"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbResType",
          "properties": {
            "HAlign": "Fill",
            "Index": 1,
            "Items": [
              "Material",
              "Work",
              "Cost"
            ],
            "Text": "Work"
          }
        },
        {
          "type": "Label",
          "name": "LblResMax",
          "properties": {
            "HAlign": "End",
            "Text": "Max units"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtResMax",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "1"
          }
        },
        {
          "type": "Label",
          "name": "LblResRate",
          "properties": {
            "HAlign": "End",
            "Text": "Rate"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtResRate",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "50"
          }
        },
        {
          "type": "Label",
          "name": "LblResCostUse",
          "properties": {
            "HAlign": "End",
            "Text": "Cost per use"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtResCostUse",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "0"
          }
        },
        {
          "type": "Label",
          "name": "LblResCalendar",
          "properties": {
            "HAlign": "End",
            "Text": "Calendar"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbResCalendar",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "ResButtons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 6,
        "Width": 588
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnResNew",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "document-new-symbolic",
            "Text": "New"
          }
        },
        {
          "type": "Button",
          "name": "BtnResApply",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "document-save-symbolic",
            "Text": "Apply"
          }
        },
        {
          "type": "Button",
          "name": "BtnResDel",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "user-trash-symbolic",
            "Text": "Delete"
          }
        },
        {
          "type": "Button",
          "name": "BtnResRates",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "view-list-symbolic",
            "Text": "Rates…"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 588,
        "Y": -104
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Close"
          }
        }
      ]
    }
  ]
}

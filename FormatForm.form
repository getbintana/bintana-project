{
  "format": "bintana-form/1",
  "class": "FormatForm",
  "properties": {
    "Text": "Chart format",
    "Arrangement": "Vertical",
    "Spacing": 12,
    "Padding": "16",
    "Width": 360,
    "Resizable": false,
    "Height": 256
  },
  "children": [
    {
      "type": "Grid",
      "name": "Fields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 356,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 388
      },
      "children": [
        {
          "type": "Label",
          "name": "LblTheme",
          "properties": {
            "HAlign": "End",
            "Text": "Colors"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbTheme",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Index": 0,
            "Items": [
              "Classic",
              "Forest",
              "Amber",
              "Violet",
              "Graphite",
              "Custom"
            ],
            "Text": "Classic"
          }
        },
        {
          "type": "Grid",
          "name": "CustomColors",
          "properties": {
            "ColumnSpacing": 8,
            "ColumnSpan": 2,
            "HAlign": "Fill",
            "HExpand": true,
            "RowSpacing": 8,
            "Spacing": 8,
            "Visible": false
          },
          "children": [
            {
              "type": "Label",
              "name": "LblBar",
              "properties": {
                "HAlign": "End",
                "Text": "Task color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrBar",
              "properties": {
                "HAlign": "Start",
                "Value": "#1c71d8"
              }
            },
            {
              "type": "Label",
              "name": "LblLate",
              "properties": {
                "HAlign": "End",
                "Text": "Critical task color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrLate",
              "properties": {
                "HAlign": "Start",
                "Value": "#c01c28"
              }
            },
            {
              "type": "Label",
              "name": "LblTodayColor",
              "properties": {
                "HAlign": "End",
                "Text": "Today's line color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrToday",
              "properties": {
                "HAlign": "Start",
                "Value": "#e01b24"
              }
            },
            {
              "type": "Label",
              "name": "LblProgress",
              "properties": {
                "HAlign": "End",
                "Text": "Progress color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrProgress",
              "properties": {
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblLink",
              "properties": {
                "HAlign": "End",
                "Text": "Dependency color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrLink",
              "properties": {
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblIdle",
              "properties": {
                "HAlign": "End",
                "Text": "Non-working days color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrIdle",
              "properties": {
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblBaseline",
              "properties": {
                "HAlign": "End",
                "Text": "Baseline color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrBaseline",
              "properties": {
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblSelect",
              "properties": {
                "HAlign": "End",
                "Text": "Selected row color"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrSelect",
              "properties": {
                "HAlign": "Start"
              }
            }
          ]
        },
        {
          "type": "Label",
          "name": "LblLabel",
          "properties": {
            "HAlign": "End",
            "Text": "Next to the bar"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbLabel",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Index": 0,
            "Items": [
              "Nothing",
              "Name",
              "Resources",
              "Percent complete",
              "Dates",
              "Duration",
              "Work",
              "Cost",
              "WBS"
            ],
            "Text": "Nothing"
          }
        },
        {
          "type": "Label",
          "name": "LblSize",
          "properties": {
            "HAlign": "End",
            "Text": "Bar size"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbSize",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Index": 1,
            "Items": [
              "Small",
              "Normal",
              "Large"
            ],
            "Text": "Normal"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkCritical",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Critical tasks in their own color"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkProgress",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Show progress inside the bar"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkLinks",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Show dependencies"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkToday",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Show today's line"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkRows",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Show row lines"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkGrid",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Show vertical grid lines"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkIdle",
          "properties": {
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Shade non-working days"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 388,
        "Y": -44
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

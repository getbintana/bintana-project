{
  "format": "bintana-form/1",
  "class": "FormatForm",
  "properties": {
    "Text": "Chart format",
    "Arrangement": "Vertical",
    "Spacing": 12,
    "Padding": "16",
    "Width": 420,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "Fields",
      "properties": {
        "Columns": 2,
        "RowSpacing": 8,
        "ColumnSpacing": 8
      },
      "children": [
        {
          "type": "Label",
          "name": "LblTheme",
          "properties": {
            "Text": "Colors",
            "HAlign": "End"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbTheme",
          "properties": {
            "Items": [
              "Classic",
              "Forest",
              "Amber",
              "Violet",
              "Graphite",
              "Custom"
            ],
            "Index": 0,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Grid",
          "name": "CustomColors",
          "properties": {
            "Columns": 2,
            "RowSpacing": 8,
            "ColumnSpacing": 8,
            "ColumnSpan": 2,
            "HExpand": true,
            "HAlign": "Fill",
            "Visible": false
          },
          "children": [
            {
              "type": "Label",
              "name": "LblBar",
              "properties": {
                "Text": "Task color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrBar",
              "properties": {
                "Value": "#1c71d8",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblLate",
              "properties": {
                "Text": "Critical task color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrLate",
              "properties": {
                "Value": "#c01c28",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblTodayColor",
              "properties": {
                "Text": "Today's line color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrToday",
              "properties": {
                "Value": "#e01b24",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblProgress",
              "properties": {
                "Text": "Progress color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrProgress",
              "properties": {
                "Value": "",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblLink",
              "properties": {
                "Text": "Dependency color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrLink",
              "properties": {
                "Value": "",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblIdle",
              "properties": {
                "Text": "Non-working days color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrIdle",
              "properties": {
                "Value": "",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblBaseline",
              "properties": {
                "Text": "Baseline color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrBaseline",
              "properties": {
                "Value": "",
                "HAlign": "Start"
              }
            },
            {
              "type": "Label",
              "name": "LblSelect",
              "properties": {
                "Text": "Selected row color",
                "HAlign": "End"
              }
            },
            {
              "type": "ColorButton",
              "name": "ClrSelect",
              "properties": {
                "Value": "",
                "HAlign": "Start"
              }
            }
          ]
        },
        {
          "type": "Label",
          "name": "LblLabel",
          "properties": {
            "Text": "Next to the bar",
            "HAlign": "End"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbLabel",
          "properties": {
            "Items": [
              "Nothing",
              "Name",
              "Resources",
              "Percent complete",
              "Dates",
              "Duration",
              "Work",
              "Cost",
              "WBS"
            ],
            "Index": 0,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblSize",
          "properties": {
            "Text": "Bar size",
            "HAlign": "End"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbSize",
          "properties": {
            "Items": [
              "Small",
              "Normal",
              "Large"
            ],
            "Index": 1,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkCritical",
          "properties": {
            "Text": "Critical tasks in their own color",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkProgress",
          "properties": {
            "Text": "Show progress inside the bar",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkLinks",
          "properties": {
            "Text": "Show dependencies",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkToday",
          "properties": {
            "Text": "Show today's line",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkRows",
          "properties": {
            "Text": "Show row lines",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkGrid",
          "properties": {
            "Text": "Show vertical grid lines",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkIdle",
          "properties": {
            "Text": "Shade non-working days",
            "Active": true,
            "ColumnSpan": 2,
            "HAlign": "Start"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "VAlign": "End"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Text": "Cancel",
            "Cancel": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Text": "OK",
            "Default": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        }
      ]
    }
  ]
}

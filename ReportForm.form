{
  "format": "bintana-form/1",
  "class": "ReportForm",
  "properties": {
    "Text": "Report",
    "Arrangement": "Vertical",
    "Spacing": 12,
    "Padding": "12",
    "Width": 1000,
    "Height": 700,
    "Resizable": true
  },
  "children": [
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Horizontal",
        "Expand": true,
        "HExpand": true,
        "Height": 630,
        "Spacing": 12,
        "VExpand": true,
        "Width": 976
      },
      "children": [
        {
          "type": "Scroller",
          "name": "OptionsScroll",
          "properties": {
            "Arrangement": "Vertical",
            "Scrollbars": "Vertical",
            "VExpand": true,
            "Width": 250
          },
          "children": [
            {
              "type": "Panel",
              "name": "Options",
              "properties": {
                "Arrangement": "Vertical",
                "HExpand": true,
                "Spacing": 4
              },
              "children": [
                {
                  "type": "Label",
                  "name": "LblContent",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Content"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblTitle",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Title"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtTitle",
                  "properties": {
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblSubtitle",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Subtitle"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtSubtitle",
                  "properties": {
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkPath",
                  "properties": {
                    "Text": "Show the file's path"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblNotes",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Notes"
                  }
                },
                {
                  "type": "TextEditor",
                  "name": "TxtNotes",
                  "properties": {
                    "HAlign": "Fill",
                    "Height": 70,
                    "Wrap": true
                  }
                },
                {
                  "type": "Label",
                  "name": "LblNotesWhere",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Notes position"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbNotesWhere",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "Footer",
                      "Header"
                    ],
                    "Text": "Footer"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblLogo",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Logo"
                  }
                },
                {
                  "type": "Panel",
                  "name": "LogoRow",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "HExpand": true,
                    "Spacing": 4
                  },
                  "children": [
                    {
                      "type": "TextBox",
                      "name": "TxtLogo",
                      "properties": {
                        "HExpand": true,
                        "HAlign": "Fill"
                      }
                    },
                    {
                      "type": "Button",
                      "name": "BtnLogo",
                      "properties": {
                        "Text": "Choose…",
                        "Width": 84
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "name": "LblTasks",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Tasks"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbTasks",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "All tasks",
                      "Only critical tasks",
                      "Only unfinished tasks"
                    ],
                    "Text": "All tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkSummaries",
                  "properties": {
                    "Text": "Include summary tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkStripes",
                  "properties": {
                    "Text": "Shade alternate rows"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblColumns",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Columns"
                  }
                },
                {
                  "type": "Grid",
                  "name": "ColumnsGrid",
                  "properties": {
                    "ColumnSpacing": 6,
                    "Columns": 3,
                    "HExpand": true,
                    "RowSpacing": 4
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblColHead",
                      "properties": {
                        "HAlign": "Start",
                        "Style": "dim-label",
                        "Text": "Column"
                      }
                    },
                    {
                      "type": "Label",
                      "name": "LblColWidthHead",
                      "properties": {
                        "HAlign": "Start",
                        "Style": "dim-label",
                        "Text": "Width (mm)"
                      }
                    },
                    {
                      "type": "Label",
                      "name": "LblColAlignHead",
                      "properties": {
                        "HAlign": "Start",
                        "Style": "dim-label",
                        "Text": "Alignment"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColStart",
                      "properties": {
                        "Text": "Start",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColStartWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColStartAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColFinish",
                      "properties": {
                        "Text": "Finish",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColFinishWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColFinishAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColDuration",
                      "properties": {
                        "Text": "Duration",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColDurationWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColDurationAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColComplete",
                      "properties": {
                        "Text": "Complete",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColCompleteWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColCompleteAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColCritical",
                      "properties": {
                        "Text": "Critical",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColCriticalWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColCriticalAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    },
                    {
                      "type": "CheckButton",
                      "name": "ChkColCost",
                      "properties": {
                        "Text": "Cost",
                        "HExpand": true
                      }
                    },
                    {
                      "type": "SpinBox",
                      "name": "SpnColCostWidth",
                      "properties": {
                        "HAlign": "Fill",
                        "Max": 150,
                        "Min": 0,
                        "Value": 0
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbColCostAlign",
                      "properties": {
                        "HAlign": "Fill",
                        "Index": 0,
                        "Items": [
                          "Default",
                          "Left",
                          "Center",
                          "Right"
                        ],
                        "Text": "Default"
                      }
                    }
                  ]
                },
                {
                  "type": "Label",
                  "name": "LblColHint",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "dim-label",
                    "Text": "A width of 0 is measured from what the column holds.",
                    "Wrap": true
                  }
                },
                {
                  "type": "Label",
                  "name": "LblFontScale",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Font size (%)"
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnFontScale",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 200,
                    "Min": 50,
                    "Value": 100
                  }
                },
                {
                  "type": "Label",
                  "name": "LblPageSetup",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Page"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblPaper",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Paper"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbPaper",
                  "properties": {
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOrientation",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Orientation"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOrientation",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "Portrait",
                      "Landscape"
                    ],
                    "Text": "Portrait"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblMargins",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Margins (mm)"
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnMargins",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 50,
                    "Min": 0
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Scroller",
          "name": "PreviewScroll",
          "properties": {
            "Arrangement": "Vertical",
            "Expand": true,
            "HExpand": true,
            "Style": "frame",
            "VExpand": true
          },
          "children": [
            {
              "type": "Report",
              "name": "Preview",
              "properties": {
                "Expand": true,
                "HExpand": true,
                "VExpand": true,
                "Width": 480,
                "Height": 640
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "Width": 976
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnPrev",
          "properties": {
            "Icon": "go-previous-symbolic",
            "Tooltip": "Previous page"
          }
        },
        {
          "type": "Label",
          "name": "LblPage",
          "properties": {
            "Alignment": "Center",
            "Text": "1 / 1",
            "Width": 70
          }
        },
        {
          "type": "Button",
          "name": "BtnNext",
          "properties": {
            "Icon": "go-next-symbolic",
            "Tooltip": "Next page"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbZoom",
          "properties": {
            "Index": 0,
            "Items": [
              "Whole page",
              "Page width",
              "50%",
              "75%",
              "100%",
              "150%",
              "200%"
            ],
            "Text": "Whole page",
            "Width": 150
          }
        },
        {
          "type": "Label",
          "name": "Spacer",
          "properties": {
            "HExpand": true
          }
        },
        {
          "type": "Button",
          "name": "BtnPrint",
          "properties": {
            "Text": "Print…"
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Style": "suggested-action",
            "Text": "Save PDF…"
          }
        },
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Cancel": true,
            "Text": "Close"
          }
        }
      ]
    }
  ]
}

{
  "format": "bintana-form/1",
  "class": "ReportForm",
  "properties": {
    "Text": "Report",
    "Arrangement": "Vertical",
    "Spacing": 12,
    "Padding": "12",
    "Width": 1000,
    "Height": 700,
    "Resizable": true
  },
  "children": [
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Horizontal",
        "Expand": true,
        "HExpand": true,
        "Height": 630,
        "Spacing": 12,
        "VExpand": true,
        "Width": 976
      },
      "children": [
        {
          "type": "Scroller",
          "name": "OptionsScroll",
          "properties": {
            "Arrangement": "Vertical",
            "Scrollbars": "Vertical",
            "VExpand": true,
            "Width": 250
          },
          "children": [
            {
              "type": "Panel",
              "name": "Options",
              "properties": {
                "Arrangement": "Vertical",
                "HExpand": true,
                "Spacing": 4
              },
              "children": [
                {
                  "type": "Label",
                  "name": "LblContent",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Content"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblKind",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Print"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbKind",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "Table",
                      "Gantt chart"
                    ],
                    "Text": "Table"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblTitle",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Title"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtTitle",
                  "properties": {
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkPath",
                  "properties": {
                    "Text": "Show the file's path"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblTasks",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Tasks"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbTasks",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "All tasks",
                      "Only critical tasks",
                      "Only unfinished tasks"
                    ],
                    "Text": "All tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkSummaries",
                  "properties": {
                    "Text": "Include summary tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkStripes",
                  "properties": {
                    "Text": "Shade alternate rows"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblColumns",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Columns"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColStart",
                  "properties": {
                    "Text": "Start"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColFinish",
                  "properties": {
                    "Text": "Finish"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColDuration",
                  "properties": {
                    "Text": "Duration"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColComplete",
                  "properties": {
                    "Text": "Complete"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColCritical",
                  "properties": {
                    "Text": "Critical"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkColCost",
                  "properties": {
                    "Text": "Cost"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblPageSetup",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Page"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblPaper",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Paper"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbPaper",
                  "properties": {
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOrientation",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Orientation"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOrientation",
                  "properties": {
                    "HAlign": "Fill",
                    "Index": 0,
                    "Items": [
                      "Portrait",
                      "Landscape"
                    ],
                    "Text": "Portrait"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblMargins",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Margins (mm)"
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnMargins",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 50,
                    "Min": 0
                  }
                },
                {
                  "type": "Label",
                  "name": "LblGanttSetup",
                  "properties": {
                    "HAlign": "Start",
                    "Style": "heading",
                    "Text": "Gantt chart",
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkMural",
                  "properties": {
                    "Text": "Continuous mural (sheets to join)",
                    "Visible": false
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOverlap",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Overlap to glue (mm)",
                    "Visible": false
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnOverlap",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 30,
                    "Min": 0,
                    "Value": 7,
                    "Enabled": false,
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkGuide",
                  "properties": {
                    "Text": "Include an assembly guide",
                    "Active": true,
                    "Enabled": false,
                    "Visible": false
                  }
                },
                {
                  "type": "Label",
                  "name": "LblWide",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Pages across",
                    "Visible": false
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnWide",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 20,
                    "Min": 1,
                    "Value": 1,
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkTall",
                  "properties": {
                    "Text": "Fit to pages tall",
                    "Visible": false
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnTall",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 20,
                    "Min": 1,
                    "Value": 1,
                    "Enabled": false,
                    "Visible": false
                  }
                },
                {
                  "type": "Label",
                  "name": "LblTable",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Table width (%)",
                    "Visible": false
                  }
                },
                {
                  "type": "SpinBox",
                  "name": "SpnTable",
                  "properties": {
                    "HAlign": "Fill",
                    "Max": 70,
                    "Min": 15,
                    "Value": 45,
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkRepeat",
                  "properties": {
                    "Text": "Repeat the table on every page",
                    "Active": true,
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkPhases",
                  "properties": {
                    "Text": "Start each phase on a new page",
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkPack",
                  "properties": {
                    "Text": "Join short phases on one page",
                    "Enabled": false,
                    "Visible": false
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkLegend",
                  "properties": {
                    "Text": "Show the legend",
                    "Active": true,
                    "Visible": false
                  }
                },
                {
                  "type": "Label",
                  "name": "LblFrom",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "From",
                    "Visible": false
                  }
                },
                {
                  "type": "DatePicker",
                  "name": "DateFrom",
                  "properties": {
                    "HAlign": "Fill",
                    "Value": "",
                    "Placeholder": "Plan start",
                    "Visible": false
                  }
                },
                {
                  "type": "Label",
                  "name": "LblTo",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "To",
                    "Visible": false
                  }
                },
                {
                  "type": "DatePicker",
                  "name": "DateTo",
                  "properties": {
                    "HAlign": "Fill",
                    "Value": "",
                    "Placeholder": "Plan finish",
                    "Visible": false
                  }
                },
                {
                  "type": "Button",
                  "name": "BtnWholePlan",
                  "properties": {
                    "HAlign": "Start",
                    "Text": "Whole plan",
                    "Visible": false
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Scroller",
          "name": "PreviewScroll",
          "properties": {
            "Arrangement": "Vertical",
            "Expand": true,
            "HExpand": true,
            "Style": "frame",
            "VExpand": true
          },
          "children": [
            {
              "type": "Report",
              "name": "Preview",
              "properties": {
                "Expand": true,
                "HExpand": true,
                "VExpand": true,
                "Width": 480,
                "Height": 640
              }
            },
            {
              "type": "DrawingArea",
              "name": "Sheet",
              "properties": {
                "Expand": true,
                "HExpand": true,
                "VExpand": true,
                "Visible": false,
                "Width": 480,
                "Height": 640
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "Width": 976
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnPrev",
          "properties": {
            "Icon": "go-previous-symbolic",
            "Tooltip": "Previous page"
          }
        },
        {
          "type": "Label",
          "name": "LblPage",
          "properties": {
            "Alignment": "Center",
            "Text": "1 / 1",
            "Width": 70
          }
        },
        {
          "type": "Button",
          "name": "BtnNext",
          "properties": {
            "Icon": "go-next-symbolic",
            "Tooltip": "Next page"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbZoom",
          "properties": {
            "Index": 0,
            "Items": [
              "Whole page",
              "Page width",
              "50%",
              "75%",
              "100%",
              "150%",
              "200%"
            ],
            "Text": "Whole page",
            "Width": 150
          }
        },
        {
          "type": "Label",
          "name": "Spacer",
          "properties": {
            "HExpand": true
          }
        },
        {
          "type": "Button",
          "name": "BtnPrint",
          "properties": {
            "Text": "Print…"
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Style": "suggested-action",
            "Text": "Save PDF…"
          }
        },
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Cancel": true,
            "Text": "Close"
          }
        }
      ]
    }
  ]
}

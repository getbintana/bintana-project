{
  "format": "bintana-form/1",
  "class": "StatsForm",
  "properties": {
    "Text": "Project statistics",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 760,
    "Height": 740,
    "Resizable": true
  },
  "children": [
    {
      "type": "Label",
      "name": "LblStatsTitle",
      "properties": {
        "Text": "",
        "Style": "heading",
        "Ellipsize": true,
        "HExpand": true,
        "HAlign": "Fill"
      }
    },
    {
      "type": "Scroller",
      "name": "StatsScroll",
      "properties": {
        "Arrangement": "Vertical",
        "Expand": true,
        "HAlign": "Fill",
        "VAlign": "Fill",
        "Scrollbars": "Vertical",
        "Height": 420
      },
      "children": [
        {
          "type": "Panel",
          "name": "Stats",
          "properties": {
            "Arrangement": "Vertical",
            "Spacing": 10,
            "HAlign": "Fill"
          },
          "children": [
            {
              "type": "Panel",
              "name": "Sheets",
              "properties": {
                "Arrangement": "Horizontal",
                "Spacing": 16,
                "HAlign": "Fill"
              },
              "children": [
                {
                  "type": "Panel",
                  "name": "LeftSheet",
                  "properties": {
                    "Arrangement": "Vertical",
                    "Spacing": 8,
                    "HExpand": true,
                    "HAlign": "Fill"
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblCostHeading",
                      "properties": {
                        "Text": "Cost",
                        "Style": "heading",
                        "HAlign": "Start"
                      }
                    },
                    {
                      "type": "Grid",
                      "name": "GridCost",
                      "properties": {
                        "Columns": 2,
                        "RowSpacing": 4,
                        "ColumnSpacing": 8
                      },
                      "children": [
                        {
                          "type": "Label",
                          "name": "LblTotalCost",
                          "properties": {
                            "Text": "Total cost",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtTotalCost",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblBaselineSpan",
                          "properties": {
                            "Text": "Baseline span",
                            "HAlign": "End",
                            "Tooltip": "The dates the baseline caught, and the working days they covered"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtBaselineSpan",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblScheduleVariance",
                          "properties": {
                            "Text": "Schedule variance",
                            "HAlign": "End",
                            "Tooltip": "Calendar days the plan's finish moved against its baseline; a minus means it finished early"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtScheduleVariance",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblBaselineCost",
                          "properties": {
                            "Text": "Baseline cost",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtBaselineCost",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblVariance",
                          "properties": {
                            "Text": "Cost variance",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtVariance",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblBudget",
                          "properties": {
                            "Text": "Budget",
                            "HAlign": "End",
                            "Tooltip": "What the assignments say this plan will cost; empty when it took no budget"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtBudget",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblBudgetVariance",
                          "properties": {
                            "Text": "Budget variance",
                            "HAlign": "End",
                            "Tooltip": "How far over or under the budget the plan is; a minus means under"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtBudgetVariance",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblBudgetPercent",
                          "properties": {
                            "Text": "Budget used",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtBudgetPercent",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblWork",
                          "properties": {
                            "Text": "Work",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtWork",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblWorkCost",
                          "properties": {
                            "Text": "Work resources",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtWorkCost",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblMaterialCost",
                          "properties": {
                            "Text": "Material resources",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtMaterialCost",
                          "properties": {
                            "Width": 150,
                            "HExpand": true,
                            "HAlign": "Fill",
                            "ReadOnly": true
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblCostCost",
                          "properties": {
                            "Text": "Cost resources",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtCostCost",
                          "properties": {
                            "Width": 150,

{
  "format": "bintana-form/1",
  "class": "FieldForm",
  "properties": {
    "Text": "Custom field",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 560,
    "Height": 480,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "FieldGrid",
      "properties": {
        "Columns": 2,
        "RowSpacing": 6,
        "ColumnSpacing": 8
      },
      "children": [
        {
          "type": "Label",
          "name": "LblFieldID",
          "properties": {
            "Text": "FieldID",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldID",
          "properties": {
            "Placeholder": "188743731",
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblFieldName",
          "properties": {
            "Text": "Field name",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldName",
          "properties": {
            "Placeholder": "Text1",
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblFieldAlias",
          "properties": {
            "Text": "Alias",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldAlias",
          "properties": {
            "Placeholder": "What the plan calls it",
            "HExpand": true,
            "HAlign": "Fill"
          }
        }
      ]
    },
    {
      "type": "CheckButton",
      "name": "ChkList",
      "properties": {
        "Text": "A list of values",
        "HAlign": "Start"
      }
    },
    {
      "type": "Panel",
      "name": "ListBox",
      "properties": {
        "Arrangement": "Vertical",
        "Spacing": 6,
        "Visible": false
      },
      "children": [
        {
          "type": "TableView",
          "name": "FieldValues",
          "properties": {
            "Columns": [
              {
                "Text": "Value",
                "Width": 0
              },
              {
                "Text": "Description",
                "Width": 240
              }
            ],
            "Height": 140,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Grid",
          "name": "ValueGrid",
          "properties": {
            "Columns": 2,
            "RowSpacing": 6,
            "ColumnSpacing": 8
          },
          "children": [
            {
              "type": "Label",
              "name": "LblValValue",
              "properties": {
                "Text": "Value",
                "HAlign": "End"
              }
            },
            {
              "type": "TextBox",
              "name": "TxtValValue",
              "properties": {
                "HExpand": true,
                "HAlign": "Fill"
              }
            },
            {
              "type": "Label",
              "name": "LblValDescription",
              "properties": {
                "Text": "Description",
                "HAlign": "End"
              }
            },
            {
              "type": "TextBox",
              "name": "TxtValDescription",
              "properties": {
                "HExpand": true,
                "HAlign": "Fill"
              }
            }
          ]
        },
        {
          "type": "Panel",
          "name": "ValueButtons",
          "properties": {
            "Arrangement": "Horizontal",
            "Spacing": 6
          },
          "children": [
            {
              "type": "Button",
              "name": "BtnValAdd",
              "properties": {
                "Text": "Add",
                "Icon": "list-add-symbolic",
                "HExpand": true,
                "HAlign": "Fill"
              }
            },
            {
              "type": "Button",
              "name": "BtnValDel",
              "properties": {
                "Text": "Delete",
                "Icon": "user-trash-symbolic",
                "Enabled": false,
                "HExpand": true,
                "HAlign": "Fill"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblFieldHint",
      "properties": {
        "Text": "Project's text fields run Text1 to Text30, from 188743731. A list puts a drop-down on every task.",
        "Style": "dim-label",
        "Wrap": true,
        "HAlign": "Start"
      }
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "VAlign": "End"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Text": "Cancel",
            "Cancel": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Text": "OK",
            "Default": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        }
      ]
    }
  ]
}

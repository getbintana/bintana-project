{
  "format": "bintana-form/1",
  "class": "FieldForm",
  "properties": {
    "Text": "Custom field",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 560,
    "Height": 176,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "FieldGrid",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 114,
        "RowSpacing": 6,
        "Spacing": 8,
        "Width": 528
      },
      "children": [
        {
          "type": "Label",
          "name": "LblFieldID",
          "properties": {
            "HAlign": "End",
            "Text": "FieldID"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldID",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "188743731"
          }
        },
        {
          "type": "Label",
          "name": "LblFieldName",
          "properties": {
            "HAlign": "End",
            "Text": "Field name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "Text1"
          }
        },
        {
          "type": "Label",
          "name": "LblFieldAlias",
          "properties": {
            "HAlign": "End",
            "Text": "Alias"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFieldAlias",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "What the plan calls it"
          }
        }
      ]
    },
    {
      "type": "CheckButton",
      "name": "ChkList",
      "properties": {
        "HAlign": "Start",
        "Height": 18,
        "Text": "A list of values",
        "Width": 114
      }
    },
    {
      "type": "Panel",
      "name": "ListBox",
      "properties": {
        "Arrangement": "Vertical",
        "Height": 12,
        "Spacing": 6,
        "Visible": false,
        "Width": 12
      },
      "children": [
        {
          "type": "TableView",
          "name": "FieldValues",
          "properties": {
            "Columns": [
              {
                "Text": "Value",
                "Width": 0
              },
              {
                "Text": "Description",
                "Width": 240
              }
            ],
            "HAlign": "Fill",
            "Height": 140
          }
        },
        {
          "type": "Grid",
          "name": "ValueGrid",
          "properties": {
            "ColumnSpacing": 8,
            "RowSpacing": 6,
            "Spacing": 8
          },
          "children": [
            {
              "type": "Label",
              "name": "LblValValue",
              "properties": {
                "HAlign": "End",
                "Text": "Value"
              }
            },
            {
              "type": "TextBox",
              "name": "TxtValValue",
              "properties": {
                "HAlign": "Fill",
                "HExpand": true
              }
            },
            {
              "type": "Label",
              "name": "LblValDescription",
              "properties": {
                "HAlign": "End",
                "Text": "Description"
              }
            },
            {
              "type": "TextBox",
              "name": "TxtValDescription",
              "properties": {
                "HAlign": "Fill",
                "HExpand": true
              }
            }
          ]
        },
        {
          "type": "Panel",
          "name": "ValueButtons",
          "properties": {
            "Arrangement": "Horizontal",
            "Spacing": 6
          },
          "children": [
            {
              "type": "Button",
              "name": "BtnValAdd",
              "properties": {
                "HAlign": "Fill",
                "HExpand": true,
                "Icon": "list-add-symbolic",
                "Text": "Add"
              }
            },
            {
              "type": "Button",
              "name": "BtnValDel",
              "properties": {
                "Enabled": false,
                "HAlign": "Fill",
                "HExpand": true,
                "Icon": "user-trash-symbolic",
                "Text": "Delete"
              }
            }
          ]
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblFieldHint",
      "properties": {
        "HAlign": "Start",
        "Height": 36,
        "Style": "dim-label",
        "Text": "Project's text fields run Text1 to Text30, from 188743731. A list puts a drop-down on every task.",
        "Width": 321,
        "Wrap": true
      }
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 528,
        "Y": -304
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

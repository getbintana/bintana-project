        {
          "separator": true
        },
        {
          "action": "ActFilter"
        },
        {
          "separator": true
        },
        {
          "action": "ActColumns"
        }
      ]
    },
    {
      "name": "MnuProject",
      "text": "_Project",
      "children": [
        {
          "action": "ActProjData"
        },
        {
          "action": "ActProjOptions"
        },
        {
          "separator": true

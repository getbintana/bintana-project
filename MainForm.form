{
  "format": "bintana-form/1",
  "class": "MainForm",
  "properties": {
    "Text": "bintana-project",
    "Icon": "x-office-calendar-symbolic",
    "Arrangement": "Vertical",
    "Spacing": 0,
    "Padding": "0",
    "Width": 1100,
    "Height": 720,
    "AcceptFiles": true
  },
  "actions": [
    {
      "name": "ActOpen",
      "text": "Open\u2026",
      "icon": "document-open-symbolic",
      "shortcut": "<Control>o"
    },
    {
      "name": "ActSave",
      "text": "Save",
      "icon": "document-save-symbolic",
      "shortcut": "<Control>s"
    },
    {
      "name": "ActSaveAs",
      "text": "Save As\u2026",
      "icon": "document-save-as-symbolic",
      "shortcut": "<Control><Shift>s"
    },
    {
      "name": "ActExport",
      "text": "Export Chart\u2026",
      "icon": "image-x-generic-symbolic"
    },
    {
      "name": "ActQuit",
      "text": "Quit",
      "icon": "application-exit-symbolic",
      "shortcut": "<Control>q"
    },
    {
      "name": "ActUndo",
      "text": "Undo",
      "icon": "edit-undo-symbolic",
      "shortcut": "<Control>z",
      "enabled": false
    },
    {
      "name": "ActRedo",
      "text": "Redo",
      "icon": "edit-redo-symbolic",
      "shortcut": "<Control><Shift>z",
      "enabled": false
    },
    {
      "name": "ActAdd",
      "text": "Add Task",
      "icon": "list-add-symbolic",
      "shortcut": "<Control>n"
    },
    {
      "name": "ActDelete",
      "text": "Delete Task",
      "icon": "user-trash-symbolic",
      "enabled": false
    },
    {
      "name": "ActIndent",
      "text": "Indent",
      "icon": "format-indent-more-symbolic",
      "enabled": false
    },
    {
      "name": "ActOutdent",
      "text": "Outdent",
      "icon": "format-indent-less-symbolic",
      "enabled": false
    },
    {
      "name": "ActUp",
      "text": "Move Up",
      "icon": "go-up-symbolic",
      "enabled": false
    },
    {
      "name": "ActDown",
      "text": "Move Down",
      "icon": "go-down-symbolic",
      "enabled": false
    },
    {
      "name": "ActRecalc",
      "text": "Recalculate",
      "icon": "view-refresh-symbolic",
      "shortcut": "F5"
    },
    {
      "name": "ActSettings",
      "text": "Settings\u2026",
      "icon": "preferences-system-symbolic"
    }
  ],
  "menus": [
    {
      "name": "MnuFile",
      "text": "_File",
      "children": [
        {
          "action": "ActOpen"
        },
        {
          "name": "MnuRecent",
          "text": "Open Recent",
          "dynamic": true
        },
        {
          "separator": true
        },
        {
          "action": "ActSave"
        },
        {
          "action": "ActSaveAs"
        },
        {
          "separator": true
        },
        {
          "action": "ActExport"
        },
        {
          "separator": true
        },
        {
          "action": "ActQuit"
        }
      ]
    },
    {
      "name": "MnuEdit",
      "text": "_Edit",
      "children": [
        {
          "action": "ActUndo"
        },
        {
          "action": "ActRedo"
        },
        {
          "separator": true
        },
        {
          "action": "ActAdd"
        },
        {
          "action": "ActDelete"
        },
        {
          "separator": true
        },
        {
          "action": "ActIndent"
        },
        {
          "action": "ActOutdent"
        },
        {
          "action": "ActUp"
        },
        {
          "action": "ActDown"
        },
        {
          "separator": true
        },
        {
          "action": "ActRecalc"
        }
      ]
    },
    {
      "name": "MnuView",
      "text": "_View",
      "children": [
        {
          "name": "MnuLog",
          "text": "Show log",
          "check": true
        }
      ]
    },
    {
      "name": "MnuTools",
      "text": "_Tools",
      "children": [
        {
          "action": "ActSettings"
        }
      ]
    },
    {
      "name": "MnuHelp",
      "text": "_Help",
      "children": [
        {
          "name": "MnuAbout",
          "text": "About bintana-project"
        }
      ]
    }
  ],
  "children": [
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 4,
        "Padding": "6",

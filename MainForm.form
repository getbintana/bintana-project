{
  "format": "bintana-form/1",
  "class": "MainForm",
  "properties": {
    "Text": "bintana-project",
    "Icon": "x-office-calendar-symbolic",
    "Arrangement": "Vertical",
    "Spacing": 0,
    "Padding": "0",
    "Width": 1240,
    "Height": 720,
    "AcceptFiles": true
  },
  "actions": [
    {
      "name": "ActOpen",
      "text": "Open\u2026",
      "icon": "document-open-symbolic",
      "shortcut": "<Control>o"
    },
    {
      "name": "ActSave",
      "text": "Save",
      "icon": "document-save-symbolic",
      "shortcut": "<Control>s"
    },
    {
      "name": "ActSaveAs",
      "text": "Save As\u2026",
      "icon": "document-save-as-symbolic",
      "shortcut": "<Control><Shift>s"
    },
    {
      "name": "ActExport",
      "text": "Export Chart\u2026",
      "icon": "image-x-generic-symbolic"
    },
    {
      "name": "ActQuit",
      "text": "Quit",
      "icon": "application-exit-symbolic",
      "shortcut": "<Control>q"
    },
    {
      "name": "ActUndo",
      "text": "Undo",
      "icon": "edit-undo-symbolic",
      "shortcut": "<Control>z",
      "enabled": false
    },
    {
      "name": "ActRedo",
      "text": "Redo",
      "icon": "edit-redo-symbolic",
      "shortcut": "<Control><Shift>z",
      "enabled": false
    },
    {
      "name": "ActAdd",
      "text": "Add Task",
      "icon": "list-add-symbolic",
      "shortcut": "<Control>n"
    },
    {
      "name": "ActDelete",
      "text": "Delete Task",
      "icon": "user-trash-symbolic",
      "enabled": false
    },
    {
      "name": "ActIndent",
      "text": "Indent",
      "icon": "format-indent-more-symbolic",
      "enabled": false
    },
    {
      "name": "ActOutdent",
      "text": "Outdent",
      "icon": "format-indent-less-symbolic",
      "enabled": false
    },
    {
      "name": "ActUp",
      "text": "Move Up",
      "icon": "go-up-symbolic",
      "enabled": false
    },
    {
      "name": "ActDown",
      "text": "Move Down",
      "icon": "go-down-symbolic",
      "enabled": false
    },
    {
      "name": "ActRecalc",
      "text": "Recalculate",
      "icon": "view-refresh-symbolic",
      "shortcut": "F5"
    },
    {
      "name": "ActSettings",
      "text": "Settings\u2026",
      "icon": "preferences-system-symbolic"
    },
    {
      "name": "ActBaseline",
      "text": "Save Baseline",
      "icon": "document-save-symbolic"
    },
    {
      "name": "ActReport",
      "text": "Report\u2026",
      "icon": "x-office-document-symbolic"
    },
    {
      "name": "ActProjData",
      "text": "Project data\u2026",
      "icon": "document-properties-symbolic"
    },
    {
      "name": "ActProjOptions",
      "text": "Project options\u2026",
      "icon": "preferences-system-symbolic"
    },
    {
      "name": "ActCalendar",
      "text": "Calendar\u2026",
      "icon": "x-office-calendar-symbolic"
    },
    {
      "name": "ActFilter",
      "text": "Filter tasks",
      "icon": "edit-find-symbolic",
      "shortcut": "<Control>f"
    }
  ],
  "menus": [
    {
      "name": "MnuFile",
      "text": "_File",
      "children": [
        {
          "action": "ActOpen"
        },
        {
          "name": "MnuRecent",
          "text": "Open Recent",
          "dynamic": true
        },
        {
          "separator": true
        },
        {
          "action": "ActSave"
        },
        {
          "action": "ActSaveAs"
        },
        {
          "separator": true
        },
        {
          "action": "ActExport"
        },
        {
          "action": "ActReport"
        },
        {
          "separator": true
        },
        {
          "action": "ActQuit"
        }
      ]
    },
    {
      "name": "MnuEdit",
      "text": "_Edit",
      "children": [
        {
          "action": "ActUndo"
        },
        {
          "action": "ActRedo"
        },
        {
          "separator": true
        },
        {
          "action": "ActAdd"
        },
        {
          "action": "ActDelete"
        },
        {
          "separator": true
        },
        {
          "action": "ActIndent"
        },
        {
          "action": "ActOutdent"
        },
        {
          "action": "ActUp"
        },
        {
          "action": "ActDown"
        },
        {
          "separator": true
        },
        {
          "action": "ActRecalc"
        },
        {
          "separator": true
        },
        {
          "action": "ActBaseline"
        }
      ]
    },
    {
      "name": "MnuView",
      "text": "_View",
      "children": [
        {
          "name": "MnuLog",
          "text": "Show log",
          "check": true
        },
        {
          "separator": true
        },
        {
          "action": "ActFilter"
        }
      ]
    },
    {
      "name": "MnuProject",
      "text": "_Project",
      "children": [
        {
          "action": "ActProjData"
        },
        {
          "action": "ActProjOptions"
        },
        {
          "separator": true
        },
        {
          "action": "ActCalendar"
        }
      ]
    },
    {
      "name": "MnuTools",
      "text": "_Tools",
      "children": [
        {
          "action": "ActSettings"
        }
      ]
    },
    {
      "name": "MnuHelp",
      "text": "_Help",
      "children": [
        {
          "name": "MnuAbout",
          "text": "About bintana-project"
        }
      ]
    }
  ],
  "children": [
    {
      "type": "Panel",
      "name": "Bar",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 4,
        "Padding": "6",
        "Style": "toolbar"
      },
      "children": [
        {
          "type": "Button",
          "name": "ToolOpen",
          "properties": {
            "Action": "ActOpen",
            "Icon": "document-open-symbolic",
            "Tooltip": "Open a Project XML file",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolSave",
          "properties": {
            "Action": "ActSave",
            "Icon": "document-save-symbolic",
            "Tooltip": "Save",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolSaveAs",
          "properties": {
            "Action": "ActSaveAs",
            "Icon": "document-save-as-symbolic",
            "Tooltip": "Save As\u2026",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep1",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolUndo",
          "properties": {
            "Action": "ActUndo",
            "Icon": "edit-undo-symbolic",
            "Tooltip": "Undo",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolRedo",
          "properties": {
            "Action": "ActRedo",
            "Icon": "edit-redo-symbolic",
            "Tooltip": "Redo",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep2",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolAdd",
          "properties": {
            "Action": "ActAdd",
            "Icon": "list-add-symbolic",
            "Tooltip": "Add a task after the selected one",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolDelete",
          "properties": {
            "Action": "ActDelete",
            "Icon": "user-trash-symbolic",
            "Tooltip": "Delete the selected task and its subtree",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolOutdent",
          "properties": {
            "Action": "ActOutdent",
            "Icon": "format-indent-less-symbolic",
            "Tooltip": "Outdent",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolIndent",
          "properties": {
            "Action": "ActIndent",
            "Icon": "format-indent-more-symbolic",
            "Tooltip": "Indent",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep3",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolRecalc",
          "properties": {
            "Action": "ActRecalc",
            "Icon": "view-refresh-symbolic",
            "Tooltip": "Recalculate the plan",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep4",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolExport",
          "properties": {
            "Action": "ActExport",
            "Icon": "image-x-generic-symbolic",
            "Tooltip": "Export the chart as PNG or PDF",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolSettings",
          "properties": {
            "Action": "ActSettings",
            "Icon": "preferences-system-symbolic",
            "Tooltip": "Settings",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep5",
          "properties": {}
        },
        {
          "type": "TextBox",
          "name": "TxtFilter",
          "properties": {
            "Placeholder": "Filter tasks",
            "Icon": "edit-find-symbolic",
            "Width": 220
          }
        },
        {
          "type": "Label",
          "name": "LblFile",
          "properties": {
            "Ellipsize": true,
            "HExpand": true,
            "HAlign": "Fill",
            "Style": "dim-label"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Vertical",
        "Spacing": 0,
        "Padding": "10 12 4 12",
        "Expand": true
      },
      "children": [
        {
          "type": "Split",
          "name": "BodySplit",
          "properties": {
            "Arrangement": "Horizontal",
            "Position": 660,
            "Grows": "End",
            "Expand": true
          },
          "children": [
            {
              "type": "Panel",
              "name": "Left",
              "properties": {
                "Arrangement": "Vertical",
                "Spacing": 8,
                "HAlign": "Fill"
              },
              "children": [
                {
                  "type": "TableView",
                  "name": "Tasks",
                  "properties": {
                    "Columns": [
                      {
                        "Text": "Task",
                        "Width": 0
                      },
                      {
                        "Text": "Duration",
                        "Width": 84,
                        "Alignment": "Right"
                      },
                      {
                        "Text": "Start",
                        "Width": 130
                      },
                      {
                        "Text": "Finish",
                        "Width": 130
                      },
                      {
                        "Text": "Attr",
                        "Width": 90,
                        "Alignment": "Right"
                      },
                      {
                        "Text": "Cost",
                        "Width": 80,
                        "Alignment": "Right"
                      }
                    ],
                    "Expand": true,
                    "MinHeight": 160,
                    "HAlign": "Fill",
                    "Menu": [
                      {
                        "action": "ActAdd"
                      },
                      {
                        "action": "ActDelete"
                      },
                      {
                        "separator": true
                      },
                      {
                        "action": "ActIndent"
                      },
                      {
                        "action": "ActOutdent"
                      },
                      {
                        "action": "ActUp"
                      },
                      {
                        "action": "ActDown"
                      }
                    ]
                  }
                },
                {
                  "type": "Panel",
                  "name": "GanttBar",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "Spacing": 8
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblScale",
                      "properties": {
                        "Text": "Timescale"
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbScale",
                      "properties": {
                        "Items": [
                          "Fit to window",
                          "Days",
                          "Weeks",
                          "Months"
                        ],
                        "Index": 0,
                        "Width": 170
                      }
                    },
                    {
                      "type": "Label",
                      "name": "LblDrawType",
                      "properties": {
                        "Text": "New link",
                        "HExpand": true,
                        "HAlign": "End"
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbDrawType",
                      "properties": {
                        "Items": [
                          "Finish to start",
                          "Start to start",
                          "Finish to finish",
                          "Start to finish"
                        ],
                        "Index": 0,
                        "Width": 170
                      }
                    }
                  ]
                },
                {
                  "type": "Scroller",
                  "name": "GanttScroll",
                  "properties": {
                    "Height": 220,
                    "MinHeight": 140,
                    "HAlign": "Fill",
                    "Scrollbars": "Both"
                  },
                  "children": [
                    {
                      "type": "DrawingArea",
                      "name": "Gantt",
                      "properties": {
                        "Width": 600,
                        "Height": 240,
                        "Menu": [
                          {
                            "action": "ActAdd"
                          },
                          {
                            "action": "ActDelete"
                          },
                          {
                            "separator": true
                          },
                          {
                            "action": "ActIndent"
                          },
                          {
                            "action": "ActOutdent"
                          },
                          {
                            "action": "ActUp"
                          },
                          {
                            "action": "ActDown"
                          }
                        ]
                      }
                    }
                  ]
                },
                {
                  "type": "TextEditor",
                  "name": "Log",
                  "properties": {
                    "ReadOnly": true,
                    "Height": 100,
                    "HAlign": "Fill",
                    "Style": "frame",
                    "Visible": false
                  }
                }
              ]
            },
            {
              "type": "Scroller",
              "name": "PropsScroll",
              "properties": {
                "Arrangement": "Vertical",
                "HAlign": "Fill",
                "VAlign": "Fill",
                "Scrollbars": "Both"
              },
              "children": [
                {
                  "type": "Panel",
                  "name": "Props",
                  "properties": {
                    "Arrangement": "Vertical",
                    "Spacing": 8,
                    "Padding": "8 12 8 12",
                    "HAlign": "Fill"
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblTask",
                      "properties": {
                        "Text": "No task selected",
                        "Style": "heading",
                        "Ellipsize": true,
                        "HAlign": "Fill"
                      }
                    },
                    {
                      "type": "Switcher",
                      "name": "PropsTabs",
                      "properties": {
                        "Current": 0,
                        "Strip": "Top",
                        "HAlign": "Fill",
                        "Tabs": [
                          "Task",
                          "Links",
                          "Resources",
                          "Project"
                        ]
                      },
                      "children": [
                        {
                          "type": "Panel",
                          "name": "PageTask",
                          "properties": {
                            "Arrangement": "Vertical",
                            "Spacing": 8,
                            "Padding": "8 0 8 0",
                            "HAlign": "Fill"
                          },
                          "children": [
                            {
                              "type": "Grid",
                              "name": "Fields",
                              "properties": {
                                "Columns": 2,
                                "RowSpacing": 4,
                                "ColumnSpacing": 8
                              },
                              "children": [
                                {
                                  "type": "Label",
                                  "name": "LblName",
                                  "properties": {
                                    "Text": "Name",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtName",
                                  "properties": {
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblSecDates",
                                  "properties": {
                                    "Text": "Dates",
                                    "Style": "heading",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblStart",
                                  "properties": {
                                    "Text": "Start",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtStart",
                                  "properties": {
                                    "Placeholder": "YYYY-MM-DD HH:MM",
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblFinish",
                                  "properties": {
                                    "Text": "Finish",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtFinish",
                                  "properties": {
                                    "Placeholder": "YYYY-MM-DD HH:MM",
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblDuration",
                                  "properties": {
                                    "Text": "Duration",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtDuration",
                                  "properties": {
                                    "Placeholder": "2d, 8h, 30m, 2ed",
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblSecTracking",
                                  "properties": {
                                    "Text": "Tracking",
                                    "Style": "heading",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblPercent",
                                  "properties": {
                                    "Text": "Complete",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "SpinBox",
                                  "name": "SpinPercent",
                                  "properties": {
                                    "Min": 0,
                                    "Max": 100,
                                    "Value": 0,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkMilestone",
                                  "properties": {
                                    "Text": "Milestone",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkEffortDriven",
                                  "properties": {
                                    "Text": "Effort driven",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkEstimated",
                                  "properties": {
                                    "Text": "Estimated",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "CheckButton",
                                  "name": "ChkManual",
                                  "properties": {
                                    "Text": "Manually scheduled",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblSecPlanning",
                                  "properties": {
                                    "Text": "Planning",
                                    "Style": "heading",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblTaskType",
                                  "properties": {
                                    "Text": "Task type",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "ComboBox",
                                  "name": "CmbTaskType",
                                  "properties": {
                                    "Items": [
                                      "Fixed units",
                                      "Fixed duration",
                                      "Fixed work"
                                    ],
                                    "Index": 0,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblConstraint",
                                  "properties": {
                                    "Text": "Constraint",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "ComboBox",
                                  "name": "CmbConstraint",
                                  "properties": {
                                    "Items": [
                                      "As soon as possible",
                                      "As late as possible",
                                      "Must start on",
                                      "Must finish on",
                                      "Start no earlier than",
                                      "Start no later than",
                                      "Finish no earlier than",
                                      "Finish no later than"
                                    ],
                                    "Index": 0,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblConstraintDate",
                                  "properties": {
                                    "Text": "Constraint date",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtConstraint",
                                  "properties": {
                                    "Placeholder": "YYYY-MM-DD HH:MM",
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblDeadline",
                                  "properties": {
                                    "Text": "Deadline",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtDeadline",
                                  "properties": {
                                    "Placeholder": "YYYY-MM-DD HH:MM",
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblSecCustom",
                                  "properties": {
                                    "Text": "Custom field",
                                    "Style": "heading",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblAttr",
                                  "properties": {
                                    "Text": "Custom field",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "ComboBox",
                                  "name": "CmbAttr",
                                  "properties": {
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblAttrValue",
                                  "properties": {
                                    "Text": "Value",
                                    "HAlign": "End"
                                  }
                                },
                                {
                                  "type": "TextBox",
                                  "name": "TxtAttr",
                                  "properties": {
                                    "HExpand": true,
                                    "HAlign": "Fill"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblSecNotes",
                                  "properties": {
                                    "Text": "Notes",
                                    "Style": "heading",
                                    "ColumnSpan": 2,
                                    "HAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Label",
                                  "name": "LblNotes",

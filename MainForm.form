                        {
                          "type": "Label",
                          "name": "LblPercent",
                          "properties": {
                            "Text": "Complete",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "SpinBox",
                          "name": "SpinPercent",
                          "properties": {
                            "Min": 0,
                            "Max": 100,
                            "Value": 0,
                            "HAlign": "Start"
                          }
                        },
                        {
                          "type": "CheckButton",

                        {
                          "type": "Label",
                          "name": "LblDeadline",
                          "properties": {
                            "Text": "Deadline",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtDeadline",
                          "properties": {
                            "Placeholder": "YYYY-MM-DD HH:MM",
                            "HExpand": true,
                            "HAlign": "Fill"
                          }
                        },

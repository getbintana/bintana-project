                        {
                          "type": "CheckButton",
                          "name": "ChkEstimated",
                          "properties": {
                            "Text": "Estimated",
                            "ColumnSpan": 2,
                            "HAlign": "Start"
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblConstraint",
                          "properties": {
                            "Text": "Constraint",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "ComboBox",
                          "name": "CmbConstraint",
                          "properties": {
                            "Items": [
                              "As soon as possible",
                              "As late as possible",
                              "Must start on",
                              "Must finish on",
                              "Start no earlier than",
                              "Start no later than",
                              "Finish no earlier than",
                              "Finish no later than"

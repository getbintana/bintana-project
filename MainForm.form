            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolIndent",
          "properties": {
            "Action": "ActIndent",
            "Icon": "format-indent-more-symbolic",
            "Tooltip": "Indent",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep3",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolRecalc",
          "properties": {
            "Action": "ActRecalc",
            "Icon": "view-refresh-symbolic",
            "Tooltip": "Recalculate the plan",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep4",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolExport",
          "properties": {
            "Action": "ActExport",
            "Icon": "image-x-generic-symbolic",
            "Tooltip": "Export the chart as PNG or PDF",

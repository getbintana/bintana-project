                    "Tooltip": "Outdent",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolIndent",
                  "properties": {
                    "Action": "ActIndent",
                    "Icon": "format-indent-more-symbolic",
                    "Tooltip": "Indent",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Separator",
                  "name": "Sep3",
                  "properties": {}
                },
                {
                  "type": "Button",
                  "name": "ToolRecalc",
                  "properties": {
                    "Action": "ActRecalc",
                    "Icon": "view-refresh-symbolic",
                    "Tooltip": "Recalculate the plan",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Separator",
                  "name": "Sep4",
                  "properties": {}
                },
                {
                  "type": "Button",
                  "name": "ToolExport",
                  "properties": {
                    "Action": "ActExport",
                    "Icon": "image-x-generic-symbolic",
                    "Tooltip": "Export the chart as PNG or PDF",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolSettings",
                  "properties": {
                    "Action": "ActSettings",
                    "Icon": "preferences-system-symbolic",
                    "Tooltip": "Settings",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Separator",
                  "name": "Sep5",
                  "properties": {}
                },
                {
                  "type": "TextBox",
                  "name": "TxtFilter",
                  "properties": {
                    "Placeholder": "Filter tasks",
                    "Icon": "edit-find-symbolic",
                    "Width": 220
                  }
                },
                {
                  "type": "Label",
                  "name": "LblFile",
                  "properties": {
                    "Ellipsize": true,
                    "HExpand": true,
                    "HAlign": "Fill",
                    "Style": "dim-label"
                  }
                }
              ]
            },
            {
              "type": "Panel",
              "name": "Body",
              "properties": {
                "Arrangement": "Vertical",
                "Spacing": 0,
                "Margin": 12,
                "Expand": true
              },
              "children": [
                {
                  "type": "Split",
                  "name": "BodySplit",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "Position": 660,
                    "Grows": "Start",
                    "Expand": true
                  },
                  "children": [
                    {
                      "type": "Panel",
                      "name": "Left",
                      "properties": {
                        "Arrangement": "Vertical",
                        "Spacing": 8,
                        "HAlign": "Fill"
                      },
                      "children": [
                        {
                          "type": "Panel",
                          "name": "GanttBar",
                          "properties": {
                            "Arrangement": "Horizontal",
                            "Spacing": "8",
                            "HAlign": "Fill"
                          },
                          "children": [
                            {
                              "type": "Label",
                              "name": "LblScale",
                              "properties": {
                                "Text": "Timescale"
                              }
                            },
                            {
                              "type": "ComboBox",
                              "name": "CmbScale",
                              "properties": {
                                "Items": [
                                  "Fit to window",
                                  "Days",
                                  "Weeks",
                                  "Months"
                                ],
                                "Index": 0,
                                "Width": 170
                              }
                            },
                            {
                              "type": "Label",
                              "name": "LblDrawType",
                              "properties": {
                                "Text": "New link",
                                "HExpand": true,
                                "HAlign": "End"
                              }
                            },
                            {
                              "type": "ComboBox",
                              "name": "CmbDrawType",
                              "properties": {
                                "Items": [
                                  "Finish to start",
                                  "Start to start",
                                  "Finish to finish",
                                  "Start to finish"
                                ],
                                "Index": 0,
                                "Width": 170
                              }
                            }
                          ]
                        },
                        {
                          "type": "Split",
                          "name": "PlanSplit",
                          "properties": {
                            "Arrangement": "Horizontal",
                            "Position": 520,
                            "Expand": true,
                            "HAlign": "Fill",
                            "VAlign": "Fill",
                            "Grows": "End"
                          },
                          "children": [
                            {
                              "type": "TableView",
                              "name": "Tasks",
                              "properties": {
                                "Columns": [
                                  {
                                    "Text": "Task",
                                    "Width": 0
                                  },
                                  {
                                    "Text": "Duration",
                                    "Width": 84,
                                    "Alignment": "Right"
                                  },
                                  {
                                    "Text": "Start",
                                    "Width": 130
                                  },
                                  {
                                    "Text": "Finish",
                                    "Width": 130
                                  },
                                  {
                                    "Text": "Attr",
                                    "Width": 90,
                                    "Alignment": "Right"
                                  },
                                  {
                                    "Text": "Cost",
                                    "Width": 80,
                                    "Alignment": "Right"
                                  }
                                ],
                                "Expand": true,
                                "HAlign": "Fill",
                                "Menu": [
                                  {
                                    "action": "ActAdd"
                                  },
                                  {
                                    "action": "ActDelete"
                                  },
                                  {
                                    "separator": true
                                  },
                                  {
                                    "action": "ActIndent"
                                  },
                                  {
                                    "action": "ActOutdent"
                                  },
                                  {
                                    "action": "ActUp"
                                  },
                                  {
                                    "action": "ActDown"
                                  },
                                  {
                                    "separator": true
                                  },
                                  {
                                    "action": "ActColumns"
                                  }
                                ],
                                "VAlign": "Fill",
                                "HeaderMinHeight": 34
                              }
                            },
                            {
                              "type": "Panel",
                              "name": "ChartCol",
                              "properties": {
                                "Arrangement": "Vertical",
                                "HExpand": true,
                                "HAlign": "Fill",
                                "VAlign": "Fill"
                              },
                              "children": [
                                {
                                  "type": "DrawingArea",
                                  "name": "Header",
                                  "properties": {
                                    "Description": "The timescale, in a strip as tall as the table's column headings and wearing `view`, the ground a column view's heading sits on. **A heading is a control, not a picture**: the list's is, so the chart's should be, and then the two cannot drift apart in colour, in height or in the theme that paints them. What is drawn on it is only the marks, over a band the theme fills.",
                                    "Width": 0,
                                    "Height": 0,
                                    "Style": "view",
                                    "HAlign": "Fill",
                                    "VAlign": "Start"
                                  }
                                },
                                {
                                  "type": "Scroller",
                                  "name": "GanttScroll",
                                  "properties": {
                                    "Expand": true,
                                    "HAlign": "Fill",
                                    "VAlign": "Fill",
                                    "Arrangement": "Horizontal",
                                    "Scrollbars": "Horizontal"
                                  },
                                  "children": [
                                    {
                                      "type": "DrawingArea",
                                      "name": "Gantt",
                                      "properties": {
                                        "Focusable": true,
                                        "Style": "view",
                                        "HAlign": "Fill",
                                        "VAlign": "Fill",
                                        "HExpand": true,
                                        "VExpand": true,
                                        "MinHeight": 120
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "type": "TextEditor",
                          "name": "Log",
                          "properties": {
                            "Height": 100,
                            "HAlign": "Fill",
                            "MinHeight": 60
                          }
                        }
                      ]
                    },
                    {
                      "type": "Scroller",
                      "name": "PropsScroll",
                      "properties": {
                        "Arrangement": "Vertical",
                        "HAlign": "Fill",
                        "VAlign": "Fill",
                        "Scrollbars": "Both"
                      },
                      "children": [
                        {
                          "type": "Panel",
                          "name": "Props",
                          "properties": {
                            "Arrangement": "Vertical",
                            "Spacing": 8,
                            "Padding": "8 12 8 12",
                            "HAlign": "Fill"
                          },
                          "children": [
                            {
                              "type": "Label",
                              "name": "LblTask",
                              "properties": {
                                "Text": "No task selected",
                                "Style": "heading",
                                "Ellipsize": true,
                                "HAlign": "Fill"
                              }
                            },
                            {
                              "type": "Switcher",
                              "name": "PropsTabs",
                              "properties": {
                                "Current": 0,
                                "Strip": "Top",
                                "HAlign": "Fill",
                                "Tabs": [
                                  "Task",
                                  "Links",
                                  "Resources"
                                ]
                              },
                              "children": [
                                {
                                  "type": "Panel",
                                  "name": "PageTask",
                                  "properties": {
                                    "Arrangement": "Vertical",
                                    "Spacing": 8,
                                    "Padding": "8 0 8 0",
                                    "HAlign": "Fill"
                                  },
                                  "children": [
                                    {
                                      "type": "Grid",
                                      "name": "Fields",
                                      "properties": {
                                        "Columns": 2,
                                        "RowSpacing": 4,
                                        "ColumnSpacing": 8
                                      },
                                      "children": [
                                        {
                                          "type": "Label",
                                          "name": "LblName",
                                          "properties": {
                                            "Text": "Name",
                                            "HAlign": "End"
                                          }
                                        },
                                        {
                                          "type": "TextBox",
                                          "name": "TxtName",
                                          "properties": {
                                            "HExpand": true,
                                            "HAlign": "Fill"
                                          }
                                        },
                                        {
                                          "type": "Label",
                                          "name": "LblSecDates",
                                          "properties": {
                                            "Text": "Dates",
                                            "Style": "heading",
                                            "ColumnSpan": 2,
                                            "HAlign": "Start"
                                          }
                                        },
                                        {
                                          "type": "Label",
                                          "name": "LblStart",
                                          "properties": {
                                            "Text": "Start",
                                            "HAlign": "End"
                                          }
                                        },
                                        {
                                          "type": "TextBox",
                                          "name": "TxtStart",
                                          "properties": {
                                            "Placeholder": "YYYY-MM-DD HH:MM",
                                            "HExpand": true,
                                            "HAlign": "Fill"
                                          }
                                        },
                                        {
                                          "type": "Label",
                                          "name": "LblFinish",
                                          "properties": {
                                            "Text": "Finish",
                                            "HAlign": "End"
                                          }
                                        },
                                        {
                                          "type": "TextBox",
                                          "name": "TxtFinish",
                                          "properties": {
                                            "Placeholder": "YYYY-MM-DD HH:MM",
                                            "HExpand": true,
                                            "HAlign": "Fill"
                                          }
                                        },
                                        {
                                          "type": "Label",
                                          "name": "LblDuration",
                                          "properties": {
                                            "Text": "Duration",
                                            "HAlign": "End"
                                          }
                                        },
                                        {
                                          "type": "TextBox",

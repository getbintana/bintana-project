            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolSaveAs",
          "properties": {
            "Action": "ActSaveAs",
            "Icon": "document-save-as-symbolic",
            "Tooltip": "Save As\u2026",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep1",
          "properties": {}
        },
        {
          "type": "Button",

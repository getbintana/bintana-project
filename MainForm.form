{
  "format": "bintana-form/1",
  "class": "MainForm",
  "properties": {
    "Text": "bintana-project",
    "Icon": "x-office-calendar-symbolic",
    "Arrangement": "Vertical",
    "Spacing": 0,
    "Padding": "0",
    "Width": 1240,
    "Height": 720,
    "AcceptFiles": true
  },
  "actions": [
    {
      "name": "ActNew",
      "text": "New Project\u2026",
      "icon": "document-new-symbolic",
      "shortcut": "<Control><Shift>n"
    },
    {
      "name": "ActOpen",
      "text": "Open…",
      "icon": "document-open-symbolic",
      "shortcut": "<Control>o"
    },
    {
      "name": "ActSave",
      "text": "Save",
      "icon": "document-save-symbolic",
      "shortcut": "<Control>s"
    },
    {
      "name": "ActSaveAs",
      "text": "Save As…",
      "icon": "document-save-as-symbolic",
      "shortcut": "<Control><Shift>s"
    },
    {
      "name": "ActExport",
      "text": "Export Chart…",
      "icon": "image-x-generic-symbolic"
    },
    {
      "name": "ActQuit",
      "text": "Quit",
      "icon": "application-exit-symbolic",
      "shortcut": "<Control>q"
    },
    {
      "name": "ActUndo",
      "text": "Undo",
      "icon": "edit-undo-symbolic",
      "shortcut": "<Control>z",
      "enabled": false
    },
    {
      "name": "ActRedo",
      "text": "Redo",
      "icon": "edit-redo-symbolic",
      "shortcut": "<Control><Shift>z",
      "enabled": false
    },
    {
      "name": "ActAdd",
      "text": "Add Task",
      "icon": "list-add-symbolic",
      "shortcut": "<Control>n"
    },
    {
      "name": "ActDelete",
      "text": "Delete Task",
      "icon": "user-trash-symbolic",
      "enabled": false
    },
    {
      "name": "ActIndent",
      "text": "Indent",
      "icon": "format-indent-more-symbolic",
      "enabled": false
    },
    {
      "name": "ActOutdent",
      "text": "Outdent",
      "icon": "format-indent-less-symbolic",
      "enabled": false
    },
    {
      "name": "ActUp",
      "text": "Move Up",
      "icon": "go-up-symbolic",
      "enabled": false
    },
    {
      "name": "ActDown",
      "text": "Move Down",
      "icon": "go-down-symbolic",
      "enabled": false
    },
    {
      "name": "ActRecalc",
      "text": "Recalculate",
      "icon": "view-refresh-symbolic",
      "shortcut": "F5"
    },
    {
      "name": "ActSettings",
      "text": "Settings…",
      "icon": "preferences-system-symbolic"
    },
    {
      "name": "ActBaseline",
      "text": "Save Baseline",
      "icon": "document-save-symbolic"
    },
    {
      "name": "ActReport",
      "text": "Report…",
      "icon": "x-office-document-symbolic"
    },
    {
      "name": "ActProjData",
      "text": "Project data…",
      "icon": "document-properties-symbolic"
    },
    {
      "name": "ActProjOptions",
      "text": "Project options…",
      "icon": "preferences-system-symbolic"
    },
    {
      "name": "ActCalendar",
      "text": "Calendars…",
      "icon": "x-office-calendar-symbolic"
    },
    {
      "name": "ActStats",
      "text": "Statistics…",
      "icon": "view-list-ordered-symbolic"
    },
    {
      "name": "ActFilter",
      "text": "Filter tasks",
      "icon": "edit-find-symbolic",
      "shortcut": "<Control>f"
    },
    {
      "name": "ActColumns",
      "text": "Columns…",
      "icon": "view-list-symbolic"
    }
  ],
  "menus": [

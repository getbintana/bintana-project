    {
      "name": "MnuHelp",
      "text": "_Help",
      "children": [
        {
          "name": "MnuAbout",
          "text": "About bintana-project"
        }
      ]
    }
  ],
  "children": [
    {
      "type": "Switcher",
      "name": "Pages",
      "properties": {
        "Current": 1,
        "Expand": true,
        "HAlign": "Fill",
        "Strip": "None",
        "Tabs": [
          "Welcome",
          "Workspace"
        ],
        "VAlign": "Fill"
      },
      "children": [
        {
          "type": "Panel",
          "name": "WelcomeBox",
          "properties": {
            "Arrangement": "Vertical",
            "Padding": "24",
            "HAlign": "Fill",
            "VAlign": "Fill"
          },
          "children": [
            {
              "type": "Panel",
              "name": "WelcomeRow",
              "properties": {
                "Arrangement": "Horizontal",
                "Spacing": 20,
                "HAlign": "Center",
                "VAlign": "Center",
                "VExpand": true
              },
              "children": [
                {
                  "type": "Image",
                  "name": "ImgApp",
                  "properties": {
                    "Icon": "x-office-calendar-symbolic",
                    "Size": 96,
                    "VAlign": "Start"
                  }
                },
                {
                  "type": "Panel",
                  "name": "WelcomeCol",
                  "properties": {
                    "Arrangement": "Vertical",
                    "Spacing": 8,
                    "Width": 420
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblAppTitle",
                      "properties": {
                        "Style": "title-1",
                        "Text": "bintana-project",
                        "XAlign": 0
                      }
                    },
                    {
                      "type": "Label",
                      "name": "LblAppHint",
                      "properties": {
                        "Style": "dim-label",
                        "Text": "MSPDI (MS Project XML) in Bintana. Open a project, or start a new one.",
                        "Wrap": true,
                        "XAlign": 0
                      }
                    },
                    {
                      "type": "Panel",
                      "name": "WelcomeButtons",
                      "properties": {
                        "Arrangement": "Horizontal",
                        "Spacing": 8
                      },
                      "children": [
                        {
                          "type": "Button",
                          "name": "BtnNew",
                          "properties": {
                            "Action": "ActNew",
                            "HExpand": true,
                            "Height": 38,
                            "Style": "suggested-action"
                          }
                        },
                        {
                          "type": "Button",
                          "name": "BtnWelcomeOpen",
                          "properties": {
                            "Action": "ActOpen",
                            "HExpand": true,
                            "Height": 38
                          }
                        }
                      ]
                    },
                    {
                      "type": "Label",
                      "name": "LblWelcomeRecent",
                      "properties": {
                        "Style": "heading",
                        "Text": "Recent",
                        "XAlign": 0
                      }
                    },
                    {
                      "type": "ListBox",
                      "name": "WelcomeRecent",
                      "properties": {
                        "Style": "frame",
                        "Height": 160
                      }
                    },
                    {
                      "type": "Button",
                      "name": "BtnWelcomeSample",
                      "properties": {
                        "HAlign": "Start",
                        "Height": 30,
                        "Style": "flat",
                        "Text": "Open the sample",
                        "Icon": "document-open-symbolic"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "Panel",
          "name": "WorkBox",
          "properties": {
            "Arrangement": "Vertical",
            "Spacing": 0,
            "Padding": "0",
            "Expand": true,
            "HAlign": "Fill",
            "VAlign": "Fill"
          },
          "children": [
            {
              "type": "Panel",
              "name": "Bar",
              "properties": {
                "Arrangement": "Horizontal",
                "Spacing": 4,
                "Padding": "6",
                "Style": "toolbar"
              },
              "children": [
                {
                  "type": "Button",
                  "name": "ToolOpen",
                  "properties": {
                    "Action": "ActOpen",
                    "Icon": "document-open-symbolic",
                    "Tooltip": "Open a Project XML file",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolSave",
                  "properties": {
                    "Action": "ActSave",
                    "Icon": "document-save-symbolic",
                    "Tooltip": "Save",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolSaveAs",
                  "properties": {
                    "Action": "ActSaveAs",
                    "Icon": "document-save-as-symbolic",
                    "Tooltip": "Save As…",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Separator",
                  "name": "Sep1",
                  "properties": {}
                },
                {
                  "type": "Button",
                  "name": "ToolUndo",
                  "properties": {
                    "Action": "ActUndo",
                    "Icon": "edit-undo-symbolic",
                    "Tooltip": "Undo",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolRedo",
                  "properties": {
                    "Action": "ActRedo",
                    "Icon": "edit-redo-symbolic",
                    "Tooltip": "Redo",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Separator",
                  "name": "Sep2",
                  "properties": {}
                },
                {
                  "type": "Button",
                  "name": "ToolAdd",
                  "properties": {
                    "Action": "ActAdd",
                    "Icon": "list-add-symbolic",
                    "Tooltip": "Add a task after the selected one",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolDelete",
                  "properties": {
                    "Action": "ActDelete",
                    "Icon": "user-trash-symbolic",
                    "Tooltip": "Delete the selected task and its subtree",
                    "Style": "flat",
                    "Width": 34,
                    "Height": 30
                  }
                },
                {
                  "type": "Button",
                  "name": "ToolOutdent",
                  "properties": {
                    "Action": "ActOutdent",

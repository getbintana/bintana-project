            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolSettings",
          "properties": {
            "Action": "ActSettings",
            "Icon": "preferences-system-symbolic",
            "Tooltip": "Settings",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Label",
          "name": "LblFile",
          "properties": {
            "Ellipsize": true,
            "HExpand": true,
            "HAlign": "Fill",
            "Style": "dim-label"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Body",
      "properties": {
        "Arrangement": "Vertical",
        "Spacing": 0,
        "Padding": "10 12 4 12",
        "Expand": true
      },
      "children": [
        {
          "type": "Split",
          "name": "BodySplit",
          "properties": {
            "Arrangement": "Horizontal",
            "Position": 740,
            "Grows": "End",
            "Expand": true
          },
          "children": [
            {
              "type": "Panel",
              "name": "Left",
              "properties": {
                "Arrangement": "Vertical",
                "Spacing": 8,
                "HAlign": "Fill"
              },
              "children": [
                {
                  "type": "TableView",
                  "name": "Tasks",
                  "properties": {
                    "Columns": [
                      {
                        "Text": "Task",
                        "Width": 0
                      },
                      {
                        "Text": "Duration",
                        "Width": 84,
                        "Alignment": "Right"
                      },
                      {
                        "Text": "Start",
                        "Width": 130
                      },
                      {
                        "Text": "Finish",
                        "Width": 130
                      },
                      {
                        "Text": "Attr",
                        "Width": 90,
                        "Alignment": "Right"
                      }
                    ],
                    "Expand": true,
                    "MinHeight": 160,
                    "HAlign": "Fill"
                  }
                },
                {
                  "type": "Panel",
                  "name": "GanttBar",
                  "properties": {
                    "Arrangement": "Horizontal",
                    "Spacing": 8
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblScale",
                      "properties": {
                        "Text": "Timescale"
                      }
                    },
                    {
                      "type": "ComboBox",
                      "name": "CmbScale",
                      "properties": {
                        "Items": [
                          "Fit to window",
                          "Days",
                          "Weeks",
                          "Months"
                        ],
                        "Index": 0,
                        "Width": 170
                      }
                    }
                  ]
                },
                {
                  "type": "Scroller",
                  "name": "GanttScroll",
                  "properties": {
                    "Height": 220,
                    "MinHeight": 140,
                    "HAlign": "Fill",
                    "Scrollbars": "Both"
                  },
                  "children": [
                    {
                      "type": "DrawingArea",
                      "name": "Gantt",
                      "properties": {
                        "Width": 600,
                        "Height": 240
                      }
                    }
                  ]
                },
                {
                  "type": "TextEditor",
                  "name": "Log",
                  "properties": {
                    "ReadOnly": true,
                    "Height": 100,
                    "HAlign": "Fill",
                    "Style": "frame"
                  }
                }
              ]
            },
            {
              "type": "Scroller",
              "name": "PropsScroll",
              "properties": {
                "HAlign": "Fill",
                "VAlign": "Fill",
                "Scrollbars": "Vertical"
              },
              "children": [
                {
                  "type": "Panel",
                  "name": "Props",
                  "properties": {
                    "Arrangement": "Vertical",
                    "Spacing": 8,
                    "Padding": "0 0 0 12",
                    "MinWidth": 260,
                    "HAlign": "Fill"
                  },
                  "children": [
                    {
                      "type": "Label",
                      "name": "LblTask",
                      "properties": {
                        "Text": "No task selected",
                        "Style": "heading",
                        "Ellipsize": true,
                        "HAlign": "Fill"
                      }
                    },
                    {
                      "type": "Grid",
                      "name": "Fields",
                      "properties": {
                        "Columns": 2,
                        "RowSpacing": 6,
                        "ColumnSpacing": 8
                      },
                      "children": [
                        {
                          "type": "Label",
                          "name": "LblName",
                          "properties": {
                            "Text": "Name",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtName",
                          "properties": {
                            "HExpand": true,
                            "HAlign": "Fill"
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblStart",
                          "properties": {
                            "Text": "Start",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtStart",
                          "properties": {
                            "Placeholder": "YYYY-MM-DD HH:MM",
                            "HExpand": true,
                            "HAlign": "Fill"
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblFinish",
                          "properties": {
                            "Text": "Finish",
                            "HAlign": "End"
                          }
                        },
                        {
                          "type": "TextBox",
                          "name": "TxtFinish",
                          "properties": {
                            "Placeholder": "YYYY-MM-DD HH:MM",
                            "HExpand": true,
                            "HAlign": "Fill"
                          }
                        },
                        {
                          "type": "Label",
                          "name": "LblDuration",
                          "properties": {
                            "Text": "Duration",

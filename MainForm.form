            "Tooltip": "Redo",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Separator",
          "name": "Sep2",
          "properties": {}
        },
        {
          "type": "Button",
          "name": "ToolAdd",
          "properties": {
            "Action": "ActAdd",
            "Icon": "list-add-symbolic",
            "Tooltip": "Add a task after the selected one",
            "Style": "flat",
            "Width": 34,
            "Height": 30
          }
        },
        {
          "type": "Button",
          "name": "ToolDelete",
          "properties": {
            "Action": "ActDelete",
            "Icon": "user-trash-symbolic",

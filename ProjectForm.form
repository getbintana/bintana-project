{
  "format": "bintana-form/1",
  "class": "ProjectForm",
  "properties": {
    "Text": "Project data",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 660,
    "Height": 700,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblData",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Data",
        "Width": 36
      }
    },
    {
      "type": "Grid",
      "name": "GridData",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 394,
        "RowSpacing": 6,
        "Spacing": 8,
        "Width": 628
      },
      "children": [
        {
          "type": "Label",
          "name": "LblProjName",
          "properties": {
            "HAlign": "End",
            "Text": "Name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjTitle",
          "properties": {
            "HAlign": "End",
            "Text": "Title"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjTitle",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjSubject",
          "properties": {
            "HAlign": "End",
            "Text": "Subject"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjSubject",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjAuthor",
          "properties": {
            "HAlign": "End",
            "Text": "Author"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjAuthor",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjManager",
          "properties": {
            "HAlign": "End",
            "Text": "Manager"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjManager",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjCompany",
          "properties": {
            "HAlign": "End",
            "Text": "Company"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCompany",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjCategory",
          "properties": {
            "HAlign": "End",
            "Text": "Category"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCategory",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjRevision",
          "properties": {
            "HAlign": "End",
            "Text": "Revision"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjRevision",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjCreation",
          "properties": {
            "HAlign": "End",
            "Text": "Creation date"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCreation",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "ReadOnly": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjSaved",
          "properties": {
            "HAlign": "End",
            "Text": "Last saved"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjSaved",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "ReadOnly": true
          }
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblScheduling",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Scheduling",
        "Width": 82
      }
    },
    {
      "type": "Grid",
      "name": "GridScheduling",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 226,
        "RowSpacing": 6,
        "Spacing": 8,
        "Width": 628
      },
      "children": [
        {
          "type": "Label",
          "name": "LblProjCalendar",
          "properties": {
            "HAlign": "End",
            "Text": "Default calendar"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbProjCalendar",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjTotal",
          "properties": {
            "HAlign": "End",
            "Text": "Total cost"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjTotal",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "ReadOnly": true
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkProjFromStart",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Schedule from start"
          }
        },
        {
          "type": "Label",
          "name": "LblProjStart",
          "properties": {
            "HAlign": "End",
            "Text": "Start date"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjStart",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        },
        {
          "type": "Label",
          "name": "LblProjFinish",
          "properties": {
            "HAlign": "End",
            "Text": "Finish"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjFinish",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "ReadOnly": true
          }
        },
        {
          "type": "Label",
          "name": "LblProjStatus",
          "properties": {
            "HAlign": "End",
            "Text": "Status date"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjStatus",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblCurrency",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Currency",
        "Width": 67
      }
    },
    {
      "type": "Grid",
      "name": "GridCurrency",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 154,
        "RowSpacing": 6,
        "Spacing": 8,
        "Width": 628
      },
      "children": [
        {
          "type": "Label",
          "name": "LblProjCurrencyCode",
          "properties": {
            "HAlign": "End",
            "Text": "Currency code"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCurrencyCode",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "USD"
          }
        },
        {
          "type": "Label",
          "name": "LblProjCurrencySymbol",
          "properties": {
            "HAlign": "End",
            "Text": "Currency symbol"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCurrencySymbol",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "$"
          }
        },
        {
          "type": "Label",
          "name": "LblProjCurrencyDigits",
          "properties": {
            "HAlign": "End",
            "Text": "Currency digits"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtProjCurrencyDigits",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "2"
          }
        },
        {
          "type": "Label",
          "name": "LblProjCurrencyPosition",
          "properties": {
            "HAlign": "End",
            "Text": "Symbol position"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbProjCurrencyPosition",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Index": 0,
            "Items": [
              "Before",
              "After",
              "Before with space",
              "After with space"
            ],
            "Text": "Before"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 628
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

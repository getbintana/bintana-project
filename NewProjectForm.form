{
  "format": "bintana-form/1",
  "class": "NewProjectForm",
  "properties": {
    "Text": "New project",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 520,
    "Height": 400,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "Fields",
      "properties": {
        "Columns": 2,
        "RowSpacing": 8,
        "ColumnSpacing": 8
      },
      "children": [
        {
          "type": "Label",
          "name": "LblName",
          "properties": {
            "Text": "Name",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtName",
          "properties": {
            "Placeholder": "What the plan is called",
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblTitle",
          "properties": {
            "Text": "Title",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtTitle",
          "properties": {
            "Placeholder": "Optional, the line Project shows over it",
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblStart",
          "properties": {
            "Text": "Start",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtStart",
          "properties": {
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblFolder",
          "properties": {
            "Text": "Folder",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFolder",
          "properties": {
            "HExpand": true,
            "HAlign": "Fill",
            "Icon": "folder-open"
          }
        },
        {
          "type": "Label",
          "name": "LblFile",
          "properties": {
            "Text": "File",
            "HAlign": "End"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFile",
          "properties": {
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Label",
          "name": "LblHint",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Fill",
            "Style": "dim-label",
            "Text": "",
            "Wrap": true
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "VAlign": "End"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Text": "Cancel",
            "Cancel": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Button",
          "name": "BtnCreate",
          "properties": {
            "Text": "Create",
            "Default": true,
            "Style": "suggested-action",
            "HExpand": true,
            "HAlign": "Fill"
          }
        }
      ]
    }
  ]
}
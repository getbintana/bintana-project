{
  "format": "bintana-form/1",
  "class": "NewProjectForm",
  "properties": {
    "Text": "New project",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 472,
    "Height": 224,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "Fields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 228,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 488
      },
      "children": [
        {
          "type": "Label",
          "name": "LblName",
          "properties": {
            "HAlign": "End",
            "Text": "Name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "What the plan is called"
          }
        },
        {
          "type": "Label",
          "name": "LblTitle",
          "properties": {
            "HAlign": "End",
            "Text": "Title"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtTitle",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "Optional, the line Project shows over it"
          }
        },
        {
          "type": "Label",
          "name": "LblStart",
          "properties": {
            "HAlign": "End",
            "Text": "Start"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtStart",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblFolder",
          "properties": {
            "HAlign": "End",
            "Text": "Folder"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFolder",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "folder-open"
          }
        },
        {
          "type": "Label",
          "name": "LblFile",
          "properties": {
            "HAlign": "End",
            "Text": "File"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFile",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "Label",
          "name": "LblHint",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Fill",
            "Style": "dim-label",
            "Wrap": true
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 488,
        "Y": -176
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnCreate",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Style": "suggested-action",
            "Text": "Create"
          }
        }
      ]
    }
  ]
}

{
  "format": "bintana-form/1",
  "class": "FieldsForm",
  "properties": {
    "Text": "Custom fields",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 560,
    "Height": 168,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblFields",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Custom fields",
        "Width": 102
      }
    },
    {
      "type": "TableView",
      "name": "FieldList",
      "properties": {
        "Columns": [
          {
            "Text": "Name",
            "Width": 0
          },
          {
            "Text": "FieldID",
            "Width": 140
          },
          {
            "Text": "Values",
            "Width": 80,
            "Alignment": "Center"
          },
          {
            "Text": "Shown",
            "Width": 90,
            "Alignment": "Center"
          }
        ],
        "HAlign": "Fill",
        "Height": 220,
        "Style": "frame",
        "Width": 528
      }
    },
    {
      "type": "CheckButton",
      "name": "ChkShown",
      "properties": {
        "Enabled": false,
        "HAlign": "Start",
        "Height": 18,
        "Text": "Show in the list",
        "Width": 119
      }
    },
    {
      "type": "Panel",
      "name": "ListButtons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 6,
        "Width": 528
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnFieldNew",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "list-add-symbolic",
            "Text": "New…"
          }
        },
        {
          "type": "Button",
          "name": "BtnFieldEdit",
          "properties": {
            "Enabled": false,
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "document-properties-symbolic",
            "Text": "Edit…"
          }
        },
        {
          "type": "Button",
          "name": "BtnFieldDel",
          "properties": {
            "Enabled": false,
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "user-trash-symbolic",
            "Text": "Delete"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 528,
        "Y": -292
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Close"
          }
        }
      ]
    }
  ]
}

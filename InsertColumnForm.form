{
  "format": "bintana-form/1",
  "class": "InsertColumnForm",
  "properties": {
    "Text": "Insert column",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 152,
    "Height": 40,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblColumn",
      "properties": {
        "HAlign": "Start",
        "Height": 18,
        "Style": "heading",
        "Text": "Column",
        "Width": 52
      }
    },
    {
      "type": "ComboBox",
      "name": "CmbColumn",
      "properties": {
        "HAlign": "Fill",
        "Height": 34,
        "Width": 120
      }
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 308,
        "Y": -110
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

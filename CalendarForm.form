{
  "format": "bintana-form/1",
  "class": "CalendarForm",
  "properties": {
    "Text": "Calendar",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 620,
    "Height": 560,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "Top",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 34,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 588
      },
      "children": [
        {
          "type": "Label",
          "name": "LblName",
          "properties": {
            "HAlign": "End",
            "Text": "Name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblWeek",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Week days",
        "Width": 80
      }
    },
    {
      "type": "Grid",
      "name": "Week",
      "properties": {
        "ColumnSpacing": 8,
        "Columns": 3,
        "Height": 262,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 588
      },
      "children": [
        {
          "type": "Label",
          "name": "LblDay1",
          "properties": {
            "HAlign": "Start",
            "Text": "Sunday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay1",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay1",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay2",
          "properties": {
            "HAlign": "Start",
            "Text": "Monday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay2",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay2",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay3",
          "properties": {
            "HAlign": "Start",
            "Text": "Tuesday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay3",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay3",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay4",
          "properties": {
            "HAlign": "Start",
            "Text": "Wednesday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay4",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay4",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay5",
          "properties": {
            "HAlign": "Start",
            "Text": "Thursday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay5",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay5",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay6",
          "properties": {
            "HAlign": "Start",
            "Text": "Friday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay6",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay6",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        },
        {
          "type": "Label",
          "name": "LblDay7",
          "properties": {
            "HAlign": "Start",
            "Text": "Saturday"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkDay7",
          "properties": {
            "HAlign": "Start",
            "Text": "Working"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtDay7",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "08:00-12:00 13:00-17:00"
          }
        }
      ]
    },
    {
      "type": "Label",
      "name": "LblExc",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Exceptions",
        "Width": 81
      }
    },
    {
      "type": "TableView",
      "name": "Exc",
      "properties": {
        "Columns": [
          {
            "Text": "From",
            "Width": 140
          },
          {
            "Text": "To",
            "Width": 140
          },
          {
            "Text": "Name",
            "Width": 0
          },
          {
            "Text": "Kind",
            "Width": 80
          }
        ],
        "HAlign": "Fill",
        "Height": 100,
        "Style": "frame",
        "Width": 586
      }
    },
    {
      "type": "Grid",
      "name": "ExcFields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 140,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 588
      },
      "children": [
        {
          "type": "Label",
          "name": "LblExcFrom",
          "properties": {
            "HAlign": "End",
            "Text": "From"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtExcFrom",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        },
        {
          "type": "Label",
          "name": "LblExcTo",
          "properties": {
            "HAlign": "End",
            "Text": "To"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtExcTo",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "YYYY-MM-DD HH:MM"
          }
        },
        {
          "type": "Label",
          "name": "LblExcName",
          "properties": {
            "HAlign": "End",
            "Text": "Name"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtExcName",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkExcWorking",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Working"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "ExcButtons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 6,
        "Width": 588
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnExcAdd",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "list-add-symbolic",
            "Text": "Add"
          }
        },
        {
          "type": "Button",
          "name": "BtnExcDel",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Height": 24,
            "Icon": "list-remove-symbolic",
            "Text": "Remove",
            "Width": 356
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 588
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

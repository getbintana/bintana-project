{
  "format": "bintana-form/1",
  "class": "CalendarsForm",
  "properties": {
    "Text": "Calendars",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 560,
    "Height": 284,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblList",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Calendars",
        "Width": 75
      }
    },
    {
      "type": "TableView",
      "name": "CalendarList",
      "properties": {
        "Columns": [
          {
            "Text": "Name",
            "Width": 0
          },
          {
            "Text": "Base",
            "Width": 160
          }
        ],
        "HAlign": "Fill",
        "Height": 200,
        "Style": "frame",
        "Width": 528
      }
    },
    {
      "type": "Panel",
      "name": "ListButtons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 6,
        "Width": 588
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCalNew",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "list-add-symbolic",
            "Text": "New…"
          }
        },
        {
          "type": "Button",
          "name": "BtnCalEdit",
          "properties": {
            "Enabled": false,
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "document-properties-symbolic",
            "Text": "Edit…"
          }
        },
        {
          "type": "Button",
          "name": "BtnCalDel",
          "properties": {
            "Enabled": false,
            "HAlign": "Fill",
            "HExpand": true,
            "Icon": "user-trash-symbolic",
            "Text": "Delete"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 588,
        "Y": -136
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnClose",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Close"
          }
        }
      ]
    }
  ]
}

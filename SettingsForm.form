{
  "format": "bintana-form/1",
  "class": "SettingsForm",
  "properties": {
    "Text": "Settings",
    "Arrangement": "Vertical",
    "Spacing": 12,
    "Padding": "16",
    "Width": 392,
    "Height": 144,
    "Resizable": false
  },
  "children": [
    {
      "type": "Grid",
      "name": "Fields",
      "properties": {
        "ColumnSpacing": 8,
        "Height": 186,
        "RowSpacing": 8,
        "Spacing": 8,
        "Width": 428
      },
      "children": [
        {
          "type": "Label",
          "name": "LblFolder",
          "properties": {
            "HAlign": "End",
            "Text": "Folder"
          }
        },
        {
          "type": "TextBox",
          "name": "TxtFolder",
          "properties": {
            "HAlign": "Fill",
            "HExpand": true,
            "Placeholder": "Where the dialog opens"
          }
        },
        {
          "type": "Label",
          "name": "LblScale",
          "properties": {
            "HAlign": "End",
            "Text": "Timescale"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbScale",
          "properties": {
            "HAlign": "Start",
            "Index": 0,
            "Items": [
              "Auto",
              "Day",
              "Week",
              "Month"
            ],
            "Text": "Auto",
            "Width": 160
          }
        },
        {
          "type": "Label",
          "name": "LblUnit",
          "properties": {
            "HAlign": "End",
            "Text": "Duration unit"
          }
        },
        {
          "type": "ComboBox",
          "name": "CmbUnit",
          "properties": {
            "HAlign": "Start",
            "Index": 0,
            "Items": [
              "Task's own",
              "Minutes",
              "Hours",
              "Days",
              "Weeks",
              "Months"
            ],
            "Text": "Task's own",
            "Width": 160
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkAutorecalc",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Recalculate after each change"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkAutosave",
          "properties": {
            "ColumnSpan": 2,
            "HAlign": "Start",
            "Text": "Autosave every minute"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 428,
        "Y": -156
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnSave",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Save"
          }
        }
      ]
    }
  ]
}

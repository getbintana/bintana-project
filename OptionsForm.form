{
  "format": "bintana-form/1",
  "class": "OptionsForm",
  "properties": {
    "Text": "Project options",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 660,
    "Height": 520,
    "Resizable": false
  },
  "children": [
    {
      "type": "Switcher",
      "name": "OptTabs",
      "properties": {
        "Current": 0,
        "Expand": true,
        "HAlign": "Fill",
        "HExpand": true,
        "Height": 676,
        "Tabs": [
          "Defaults",
          "Calculation",
          "Earned value"
        ],
        "VAlign": "Fill",
        "VExpand": true,
        "Width": 628
      },
      "children": [
        {
          "type": "Panel",
          "name": "PageDefaults",
          "properties": {
            "Arrangement": "Vertical",
            "HAlign": "Fill",
            "Padding": "8 0 8 0",
            "Spacing": 8
          },
          "children": [
            {
              "type": "Grid",
              "name": "GridPageDefaults",
              "properties": {
                "ColumnSpacing": 8,
                "RowSpacing": 6,
                "Spacing": 8
              },
              "children": [
                {
                  "type": "Label",
                  "name": "LblOptTaskType",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default task type"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptTaskType",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Fixed units",
                      "Fixed duration",
                      "Fixed work"
                    ],
                    "Text": "Fixed units"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptAccrual",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default fixed cost accrual"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptAccrual",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Start",
                      "Prorated",
                      "End"
                    ],
                    "Text": "Start"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptStdRate",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default standard rate"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptStdRate",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "0"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptOtRate",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default overtime rate"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptOtRate",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "0"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptDurationFormat",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Duration format"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptDurationFormat",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Minutes",
                      "Hours",
                      "Days",
                      "Weeks",
                      "Months"
                    ],
                    "Text": "Minutes"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptWorkFormat",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Work format"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptWorkFormat",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Minutes",
                      "Hours",
                      "Days",
                      "Weeks",
                      "Months"
                    ],
                    "Text": "Minutes"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptWeekStart",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Week starts"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptWeekStart",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Sunday",
                      "Monday",
                      "Tuesday",
                      "Wednesday",
                      "Thursday",
                      "Friday",
                      "Saturday"
                    ],
                    "Text": "Sunday"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptNewTaskStart",
                  "properties": {
                    "HAlign": "End",
                    "Text": "New task start date"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptNewTaskStart",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Project start date",
                      "Current date"
                    ],
                    "Text": "Project start date"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptMinutesDay",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Minutes a day"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptMinutesDay",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "480"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptMinutesWeek",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Minutes a week"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptMinutesWeek",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "2400"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptDaysMonth",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Days a month"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptDaysMonth",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "20"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptStartTime",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default start time"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptStartTime",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "08:00"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptFinishTime",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default finish time"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptFinishTime",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "17:00"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptSlack",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Critical slack limit (days)"
                  }
                },
                {
                  "type": "TextBox",
                  "name": "TxtOptSlack",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Placeholder": "0"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptFY",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Fiscal year starts"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptFY",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "January",
                      "February",
                      "March",
                      "April",
                      "May",
                      "June",
                      "July",
                      "August",
                      "September",
                      "October",
                      "November",
                      "December"
                    ],
                    "Text": "January"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptFiscal",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Fiscal year start"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Panel",
          "name": "PageCalc",
          "properties": {
            "Arrangement": "Vertical",
            "HAlign": "Fill",
            "Padding": "8 0 8 0",
            "Spacing": 8
          },
          "children": [
            {
              "type": "Grid",
              "name": "GridPageCalc",
              "properties": {
                "ColumnSpacing": 8,
                "RowSpacing": 6,
                "Spacing": 8
              },
              "children": [
                {
                  "type": "CheckButton",
                  "name": "ChkOptEditableCosts",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Editable actual costs"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptHonor",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Honor constraints"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptInserted",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Inserted projects like summary"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptMultiCritical",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Multiple critical paths"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptEffort",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "New tasks effort driven"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptEstimated",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "New tasks estimated"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptSplits",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Splits in progress tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptSpreadActual",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Spread actual cost"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptSpreadPercent",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Spread percent complete"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptTaskUpdates",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Task updates resource"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptMoveCompletedBack",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Move completed ends back"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptMoveRemainingBack",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Move remaining starts back"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptMoveRemainingForward",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Move remaining starts forward"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptMoveCompletedForward",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Move completed ends forward"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptAutoAdd",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Auto add new resources and tasks"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptAutolink",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Autolink"
                  }
                },
                {
                  "type": "CheckButton",
                  "name": "ChkOptServerUrl",
                  "properties": {
                    "ColumnSpan": 2,
                    "HAlign": "Start",
                    "Text": "Microsoft Project Server URL"
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "Panel",
          "name": "PageEV",
          "properties": {
            "Arrangement": "Vertical",
            "HAlign": "Fill",
            "Padding": "8 0 8 0",
            "Spacing": 8
          },
          "children": [
            {
              "type": "Grid",
              "name": "GridPageEV",
              "properties": {
                "ColumnSpacing": 8,
                "RowSpacing": 6,
                "Spacing": 8
              },
              "children": [
                {
                  "type": "Label",
                  "name": "LblOptEVMethod",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Earned value method"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptEVMethod",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Percent complete",
                      "Physical percent complete"
                    ],
                    "Text": "Percent complete"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptEVBaseline",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Baseline for earned value"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptEVBaseline",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Baseline",
                      "Baseline 1",
                      "Baseline 2",
                      "Baseline 3",
                      "Baseline 4",
                      "Baseline 5",
                      "Baseline 6",
                      "Baseline 7",
                      "Baseline 8",
                      "Baseline 9",
                      "Baseline 10"
                    ],
                    "Text": "Baseline"
                  }
                },
                {
                  "type": "Label",
                  "name": "LblOptTaskEV",
                  "properties": {
                    "HAlign": "End",
                    "Text": "Default task earned value method"
                  }
                },
                {
                  "type": "ComboBox",
                  "name": "CmbOptTaskEV",
                  "properties": {
                    "HAlign": "Fill",
                    "HExpand": true,
                    "Index": 0,
                    "Items": [
                      "Percent complete",
                      "Physical percent complete"
                    ],
                    "Text": "Percent complete"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 628
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}

{
  "format": "bintana-form/1",
  "class": "ColumnsForm",
  "properties": {
    "Text": "Columns",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 560,
    "Height": 420,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblIntro",
      "properties": {
        "Text": "Columns the plan shows",
        "Style": "heading",
        "HAlign": "Start"
      }
    },
    {
      "type": "Grid",
      "name": "Cols",
      "properties": {
        "Columns": 2,
        "RowSpacing": 6,
        "ColumnSpacing": 16
      },
      "children": [
        {
          "type": "CheckButton",
          "name": "ChkColDuration",
          "properties": { "Text": "Duration", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColStart",
          "properties": { "Text": "Start", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColFinish",
          "properties": { "Text": "Finish", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColPercent",
          "properties": { "Text": "Percent complete", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCritical",
          "properties": { "Text": "Critical", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColSlack",
          "properties": {
            "Text": "Slack",
            "HAlign": "Start",
            "Tooltip": "How long the task can slip before the plan's finish moves"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColVariance",
          "properties": {
            "Text": "Variance",
            "HAlign": "Start",
            "Tooltip": "How late the task's finish is against its baseline; a minus means ahead"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColMilestone",
          "properties": { "Text": "Milestone", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColWork",
          "properties": { "Text": "Work", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCost",
          "properties": { "Text": "Cost", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColWbs",
          "properties": { "Text": "WBS", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColPriority",
          "properties": { "Text": "Priority", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColConstraint",
          "properties": { "Text": "Constraint", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColDeadline",
          "properties": { "Text": "Deadline", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCalendar",
          "properties": { "Text": "Calendar", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColType",
          "properties": { "Text": "Task type", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColNotes",
          "properties": { "Text": "Notes", "HAlign": "Start" }
        },
        {
          "type": "CheckButton",
          "name": "ChkColLink",
          "properties": { "Text": "Hyperlink", "HAlign": "Start" }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Spacing": 8,
        "VAlign": "End"
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Text": "Cancel",
            "Cancel": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Text": "OK",
            "Default": true,
            "HExpand": true,
            "HAlign": "Fill"
          }
        }
      ]
    }
  ]
}

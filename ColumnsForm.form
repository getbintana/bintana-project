{
  "format": "bintana-form/1",
  "class": "ColumnsForm",
  "properties": {
    "Text": "Columns",
    "Arrangement": "Vertical",
    "Spacing": 8,
    "Padding": "16",
    "Width": 468,
    "Height": 236,
    "Resizable": false
  },
  "children": [
    {
      "type": "Label",
      "name": "LblIntro",
      "properties": {
        "HAlign": "Start",
        "Height": 20,
        "Style": "heading",
        "Text": "Columns the plan shows",
        "Width": 180
      }
    },
    {
      "type": "Grid",
      "name": "Cols",
      "properties": {
        "ColumnSpacing": 16,
        "Height": 282,
        "Homogeneous": true,
        "RowSpacing": 6,
        "Spacing": 16,
        "Width": 528
      },
      "children": [
        {
          "type": "CheckButton",
          "name": "ChkColDuration",
          "properties": {
            "HAlign": "Start",
            "Text": "Duration"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColStart",
          "properties": {
            "HAlign": "Start",
            "Text": "Start"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColFinish",
          "properties": {
            "HAlign": "Start",
            "Text": "Finish"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColPercent",
          "properties": {
            "HAlign": "Start",
            "Text": "Percent complete"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCritical",
          "properties": {
            "HAlign": "Start",
            "Text": "Critical"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColSlack",
          "properties": {
            "HAlign": "Start",
            "Text": "Slack",
            "Tooltip": "How long the task can slip before the plan's finish moves"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColVariance",
          "properties": {
            "HAlign": "Start",
            "Text": "Variance",
            "Tooltip": "How late the task's finish is against its baseline; a minus means ahead"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColMilestone",
          "properties": {
            "HAlign": "Start",
            "Text": "Milestone"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColWork",
          "properties": {
            "HAlign": "Start",
            "Text": "Work"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCost",
          "properties": {
            "HAlign": "Start",
            "Text": "Cost"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColWbs",
          "properties": {
            "HAlign": "Start",
            "Text": "WBS"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColPriority",
          "properties": {
            "HAlign": "Start",
            "Text": "Priority"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColConstraint",
          "properties": {
            "HAlign": "Start",
            "Text": "Constraint"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColDeadline",
          "properties": {
            "HAlign": "Start",
            "Text": "Deadline"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColCalendar",
          "properties": {
            "HAlign": "Start",
            "Text": "Calendar"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColType",
          "properties": {
            "HAlign": "Start",
            "Text": "Task type"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColNotes",
          "properties": {
            "HAlign": "Start",
            "Text": "Notes"
          }
        },
        {
          "type": "CheckButton",
          "name": "ChkColLink",
          "properties": {
            "HAlign": "Start",
            "Text": "Hyperlink"
          }
        }
      ]
    },
    {
      "type": "Panel",
      "name": "Buttons",
      "properties": {
        "Arrangement": "Horizontal",
        "Height": 34,
        "Homogeneous": true,
        "Spacing": 8,
        "VAlign": "End",
        "Width": 528,
        "Y": -184
      },
      "children": [
        {
          "type": "Button",
          "name": "BtnCancel",
          "properties": {
            "Cancel": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "Cancel"
          }
        },
        {
          "type": "Button",
          "name": "BtnOk",
          "properties": {
            "Default": true,
            "HAlign": "Fill",
            "HExpand": true,
            "Text": "OK"
          }
        }
      ]
    }
  ]
}
